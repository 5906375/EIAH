{
  "name": "eiah-builder",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/cli",
    "apps/workers/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"./apps/*\" run build",
    "eiah": "pnpm --filter @eiah/cli start --",
    "lint": "echo \"Run linting via individual packages\"",
    "test": "pnpm --filter @eiah/core test",
    "postinstall": "pnpm --filter @eiah/core build",
    "env:validate": "node --experimental-strip-types \"scripts/env:validate.ts\"",
    "check:governance": "pnpm exec tsx apps/api/src/services/checkGovernance.ts",
    "check:e2e-recency": "node --experimental-strip-types scripts/check_e2e_recency.ts",
    "check:manifest-integrity": "node --experimental-strip-types scripts/checkManifestIntegrity.ts",
    "check:billing-webhook-evidence": "node scripts/ci/check_billing_webhook_evidence.cjs",
    "check:interop-contract-matrix": "node --experimental-strip-types scripts/checkInteropContractsMatrix.ts",
    "check:interop-spec-governance": "node --experimental-strip-types scripts/checkInteropSpecGovernance.ts",
    "check:p2-audit-interop": "node --experimental-strip-types scripts/checkP2AuditInterop.ts",
    "check:p2-high-global-coverage": "node --experimental-strip-types scripts/checkP2HighGlobalCoverage.ts",
    "check:p1-critical-chain": "node --experimental-strip-types scripts/checkP1CriticalChain.ts",
    "check:p1-reconciliation-recurring": "node --experimental-strip-types scripts/checkP1ReconciliationRecurring.ts",
    "check:p3-economy-hardening": "node --experimental-strip-types scripts/checkP3EconomyHardening.ts",
    "check:p3-stability-recurring": "node --experimental-strip-types scripts/checkP3StabilityRecurring.ts",
    "check:p3-settlement-support-by-env": "node --experimental-strip-types scripts/checkP3SettlementSupportByEnv.ts",
    "check:p4-trackp-rollout": "node --experimental-strip-types scripts/checkP4TrackPRollout.ts",
    "check:economy-invariants": "node --experimental-strip-types scripts/checkEconomyInvariants.ts",
    "check:secrets-vault": "node --experimental-strip-types scripts/checkSecretsVault.ts",
    "check:backup-restore": "node --experimental-strip-types scripts/checkBackupRestore.ts",
    "check:waf-rate-limit": "node --experimental-strip-types scripts/checkWafRateLimit.ts",
    "check:runbook-drill-recency": "node --experimental-strip-types scripts/checkRunbookDrillRecency.ts",
    "check:origin-security": "node --experimental-strip-types scripts/checkOriginSecurity.ts",
    "check:tls-compliance": "node --experimental-strip-types scripts/checkTlsCompliance.ts",
    "check:provider-pricing-recency": "node --experimental-strip-types scripts/checkProviderPricingRecency.ts",
    "check:ape-evidence-linkage": "node --experimental-strip-types scripts/checkApeEvidenceLinkage.ts",
    "check:ape-hard-metrics": "node --experimental-strip-types scripts/checkApeCycleHardMetrics.ts",
    "check:evidence-index": "node --experimental-strip-types scripts/checkEvidenceIndex.ts",
    "check:chat-agent-onboarding": "node --import tsx scripts/checkChatAgentOnboarding.ts",
    "check:provider-boundary": "pnpm --filter @eiah/api exec tsx --test src/tests/provider-boundary-enforcement.test.ts",
    "test:chat-engine": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx --test apps/web/src/components/agents/chatLauncherEngine.test.ts apps/web/src/features/imob/imobApiClient.test.ts",
    "generate:agent-registry-docs": "node --import tsx scripts/generateAgentRegistryDocs.ts",
    "check:help-playbook-drift": "node --experimental-strip-types scripts/checkHelpPlaybookDrift.ts",
    "check:receipt-canon-compat": "node --experimental-strip-types scripts/checkReceiptCanonVersioning.ts",
    "check:agent-protocol-compat": "node --experimental-strip-types scripts/checkAgentProtocolVersioning.ts",
    "check:settlement-contract-drift": "node --experimental-strip-types scripts/checkSettlementContractDrift.ts",
    "check:p3-evidence-recency": "node --experimental-strip-types scripts/checkP3EvidenceRecency.ts",
    "generate:p3-economy-evidence": "node --experimental-strip-types scripts/generateP3EconomyEvidence.ts",
    "check:w4-non-regression": "node --experimental-strip-types scripts/checkW4NonRegression.ts",
    "check:src-dist-route-parity": "pnpm exec tsx scripts/checkSrcDistRouteParity.ts",
    "check:ledger-bundle-smoke": "pnpm exec tsx scripts/checkLedgerBundleSmoke.ts",
    "verify:receipt-canon": "node --experimental-strip-types scripts/verify-receipt-canon.ts",
    "ape:cycle:weekly": "node scripts/ci/ape_cycle_weekly.cjs",
    "audit:criticality": "pnpm exec tsx scripts/auditCriticalityCoverage.ts --out artifacts/criticality-coverage.json --allowlist scripts/criticality-allowlist.txt"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@prisma/config": "^7.1.0",
    "@types/node": "^25.0.1",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@typescript-eslint/utils": "^8.49.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^7.0.1",
    "prisma": "^7.0.1"
  },
  "packageManager": "pnpm@10.12.4"
}
