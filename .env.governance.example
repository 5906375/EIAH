# ============================================
# Governanca Cognitiva (defaults seguros)
# ============================================

# Assinatura obrigatoria de intencoes (HMAC SHA-256)
INTENT_SIGNATURE_SECRET=change-me
INTENT_VALIDATOR_MODE=enforce   # [observe|enforce]
SIGNER_REQUIRED=true
SIGNER_PROVIDER=vault
SIGNER_VAULT_URL=
SIGNER_VAULT_TOKEN=

# Forca todas as actions a passarem pelo MCP Runner
MCP_PROXY_ALL_ACTIONS=true
MCP_ENFORCE_CONTRACTS=true
MCP_DEFAULT_VERSION=1.0.0

# Outbox de eventos via Redis Stream
RUN_EVENTS_USE_OUTBOX=true
RUN_EVENTS_REDIS_URL=${REDIS_URL}
RUN_EVENTS_OUTBOX_STREAM=run-events-outbox
RUN_EVENTS_OUTBOX_GROUP=run-events-group
RUN_EVENTS_OUTBOX_CONSUMER=api-local
