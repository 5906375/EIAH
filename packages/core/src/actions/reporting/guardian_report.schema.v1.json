{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eiah.ai/schemas/guardian_report.schema.v1.json",
  "title": "Guardian Report Schema v1",
  "type": "object",
  "required": [
    "route",
    "runStatus",
    "guardianDecision",
    "reasonCode",
    "evidenceStatus",
    "exportStatus",
    "piiStatus",
    "finopsStatus",
    "summary",
    "blockingIssues",
    "checklist",
    "coverageMatrix",
    "nextSteps",
    "finops",
    "auditTrail"
  ],
  "properties": {
    "route": { "type": "string" },
    "runStatus": { "type": "string", "enum": ["success", "error"] },
    "guardianDecision": { "type": "string", "enum": ["GO", "NO-GO", "DEGRADED"] },
    "reasonCode": { "type": "string", "minLength": 1 },
    "evidenceStatus": { "type": "string", "enum": ["missing", "partial", "complete"] },
    "exportStatus": { "type": "string", "enum": ["valid", "invalid", "template_mismatch"] },
    "piiStatus": { "type": "string", "enum": ["safe", "masking_required", "sensitive_business_data", "unknown"] },
    "finopsStatus": { "type": "string", "enum": ["calculated", "not_calculated", "not_reported"] },
    "summary": { "type": "string" },
    "blockingIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "severity"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3", "P4"] }
        }
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "status", "expectedEvidence", "collectedEvidence", "sha256", "blocking"],
        "properties": {
          "item": { "type": "string" },
          "status": { "type": "string", "enum": ["missing", "partial", "complete", "degraded"] },
          "expectedEvidence": { "type": "string" },
          "collectedEvidence": { "type": ["string", "null"] },
          "sha256": { "type": ["string", "null"] },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "coverageMatrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["whatParecerAsks", "whatRunAnswered", "whatStillNeedsManualReview"],
        "properties": {
          "whatParecerAsks": { "type": "string" },
          "whatRunAnswered": { "type": "string" },
          "whatStillNeedsManualReview": { "type": ["string", "null"] }
        }
      }
    },
    "nextSteps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "finops": {
      "type": "object",
      "required": [
        "model",
        "promptTokens",
        "completionTokens",
        "totalTokens",
        "estimatedCost",
        "currency"
      ],
      "properties": {
        "model": { "type": ["string", "null"] },
        "promptTokens": { "type": ["number", "null"] },
        "completionTokens": { "type": ["number", "null"] },
        "totalTokens": { "type": ["number", "null"] },
        "estimatedCost": { "type": ["number", "null"] },
        "currency": { "type": ["string", "null"] }
      }
    },
    "auditTrail": {
      "type": "object",
      "required": [
        "runId",
        "traceId",
        "receiptId",
        "verifyUrl",
        "evidenceBundleId"
      ],
      "properties": {
        "runId": { "type": "string" },
        "traceId": { "type": ["string", "null"] },
        "receiptId": { "type": ["string", "null"] },
        "verifyUrl": { "type": ["string", "null"] },
        "evidenceBundleId": { "type": ["string", "null"] }
      }
    }
  }
}
