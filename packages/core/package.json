{
  "name": "@eiah/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./queue/*": {
      "import": "./dist/queue/*.js",
      "types": "./dist/queue/*.d.ts"
    },
    "./llm/*": {
      "import": "./dist/llm/*.js",
      "types": "./dist/llm/*.d.ts"
    }
  },
  "scripts": {
    "prebuild": "bash ../../scripts/prebuild-check.sh",
    "build": "pnpm run clean && pnpm exec tsc -p tsconfig.json --emitDeclarationOnly && pnpm exec tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "TSX_TSCONFIG_PATH=tsconfig.test.json node --test --import tsx \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@eiah/contracts": "file:../contracts",
    "@repo/db": "workspace:*",
    "bullmq": "^5.62.0",
    "dotenv": "^16.6.1",
    "ioredis": "^5.8.2",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
