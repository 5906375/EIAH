{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eiah.ai/schemas/run-event.v1.1.json",
  "title": "RunEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "runId", "type", "createdAt"],
  "properties": {
    "id": { "type": "string" },
    "runId": { "type": "string" },
    "tenantId": { "type": "string" },
    "workspaceId": { "type": "string" },
    "userId": { "type": ["string", "null"] },
    "type": {
      "type": "string",
      "enum": [
        "run.requested",
        "run.enqueued",
        "run.started",
        "run.completed",
        "run.failed",
        "run.token",
        "run.token.summary",
        "run.trustscore.blocked",
        "run.intent.evaluated",
        "run.blocked.guardrails",
        "run.guardrails.evaluated",
        "run.replay.requested",
        "run.replay.enqueued",
        "run.replay.started",
        "run.replay.completed",
        "run.action.plan",
        "run.action.call",
        "run.action.result",
        "run.action.observe",
        "run.action.observe.failed",
        "run.action.replan",
        "run.action.reflect",
        "run.action.enqueued",
        "run.action.completed",
        "run.action.failed",
        "run.action.judge",
        "run.step.started",
        "run.step.completed",
        "run.step.failed",
        "run.step.skipped",
        "run.step.timeout",
        "run.plan.generated",
        "run.plan.truncated",
        "run.orchestrator.started",
        "run.orchestrator.finished",
        "run.external.legacy_api_call",
        "run.reflect.completed"
      ],
      "description": "Known event types; new types may be introduced without breaking the envelope."
    },
    "payload": {
      "type": ["object", "array", "string", "number", "boolean", "null"]
    },
    "criticalHash": { "type": ["string", "null"] },
    "sclTxId": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "schemaVersion": { "type": "string", "const": "1.1" }
  }
}
