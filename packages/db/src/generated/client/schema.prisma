generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  engineType    = "binary"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// 🧠 Enums — Execução e Pagamentos
// (necessários para validação e índices)
// ========================================

enum RunStatus {
  pending
  running
  success
  error
  blocked
  awaiting_approval
}

enum RunApprovalStatus {
  not_required
  pending
  approved
  rejected
}

enum GovernedCaseLifecycle {
  DISCOVERY
  ASSESSING
  AWAITING_REVIEW
  READY
  BLOCKED
  CLOSED
}

enum PaymentStatus {
  pending
  succeeded
  failed
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum PoUFailureReason {
  DB_WRITE_FAILED
  VALIDATION_ERROR
  SIGNER_ERROR
  OUTPUT_UNAVAILABLE
  HASH_ERROR
  ATTESTATION_FAILED
  UNKNOWN
}

enum PoUStatus {
  PENDING
  FINALIZED
  FAILED
  PENDING_TRUST
}

model Tenant {
  id                             String                          @id @default(cuid())
  name                           String
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  apiTokens                      ApiToken[]
  embeddingChunks                EmbeddingChunk[]
  guardrailLedger                GuardrailLedger[]
  memoryEvents                   MemoryEvent[]
  memorySnapshots                MemorySnapshot[]
  runEvents                      RunEvent[]
  runs                           Run[]
  uploadedDocuments              UploadedDocument[]
  users                          User[]
  workspaces                     Workspace[]
  tenantActionPolicies           TenantActionPolicy[]
  guardrailAuditLedger           GuardrailAuditLedger[]
  sclLedger                      SclLedger[]
  toolContracts                  ToolContract[]
  marketplaceItems               MarketplaceItem[]
  delegationsAsOwner             DelegationPolicy[]              @relation("DelegatorTenant")
  delegationsAsGuest             DelegationPolicy[]              @relation("DelegateeTenant")
  agentTrustScores               AgentTrustScore[]
  billingAccount                 TenantBillingAccount?
  quotaPolicy                    TenantQuotaPolicy?
  quotaUsages                    TenantQuotaUsage[]
  workspaceQuotaUsages           WorkspaceQuotaUsage[]
  workspaceQuotaGrants           WorkspaceQuotaGrant[]
  workspaceAgentAssignments      WorkspaceAgentAssignment[]
  runUsageBreakdowns             RunUsageBreakdown[]
  billingLedgerEntries           BillingLedger[]
  invoices                       TenantInvoice[]
  helpdeskSessions               HelpdeskSession[]
  productInstallations           TenantProductInstallation[]
  runArchives                    RunArchive[]
  imobOwners                     ImobOwner[]
  imobProperties                 ImobProperty[]
  imobLeads                      ImobLead[]
  imobCases                      ImobCase[]
  imobCaseEvents                 ImobCaseEvent[]
  imobMarketScanRuns             ImobMarketScanRun[]
  governedCases                  GovernedCase[]
  agentInstalls                  AgentInstall[]
  connectorInstances             ConnectorInstance[]
  paymentIntents                 PaymentIntent[]
  signalForwardRequests          SignalForwardRequest[]
  humanConfirmations             HumanConfirmation[]
  radarKnownEntities             RadarKnownEntity[]
  radarMaterials                 RadarMaterial[]
  radarAnalysisRequests          RadarAnalysisRequest[]
  radarAnalysisAttempts          RadarAnalysisAttempt[]
  radarRecommendations           RadarRecommendation[]
  radarEntityAccessGrants        RadarEntityAccessGrant[]
  radarProviderCallSlots         RadarProviderCallSlot[]
  radarRecommendationEvaluations RadarRecommendationEvaluation[]
  memberships                    TenantMembership[]
  customRoles                    TenantCustomRole[]
  walletIdentities               WalletIdentity[]

  @@map("tenants")
}

model Workspace {
  id                             String                          @id @default(cuid())
  tenantId                       String                          @map("tenant_id")
  name                           String
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  apiTokens                      ApiToken[]
  embeddingChunks                EmbeddingChunk[]
  memoryEvents                   MemoryEvent[]
  memorySnapshots                MemorySnapshot[]
  runEvents                      RunEvent[]
  runs                           Run[]
  uploadedDocuments              UploadedDocument[]
  tenant                         Tenant                          @relation(fields: [tenantId], references: [id])
  tenantActionPolicies           TenantActionPolicy[]
  guardrailAuditLedger           GuardrailAuditLedger[]
  sclLedger                      SclLedger[]
  agentTrustScores               AgentTrustScore[]
  workspaceQuotaUsages           WorkspaceQuotaUsage[]
  workspaceQuotaGrants           WorkspaceQuotaGrant[]
  workspaceAgentAssignments      WorkspaceAgentAssignment[]
  runUsageBreakdowns             RunUsageBreakdown[]
  billingLedgerEntries           BillingLedger[]
  helpdeskSessions               HelpdeskSession[]
  productInstallations           TenantProductInstallation[]
  runArchives                    RunArchive[]
  imobOwners                     ImobOwner[]
  imobProperties                 ImobProperty[]
  imobLeads                      ImobLead[]
  imobCases                      ImobCase[]
  imobCaseEvents                 ImobCaseEvent[]
  imobMarketScanRuns             ImobMarketScanRun[]
  governedCases                  GovernedCase[]
  agentInstalls                  AgentInstall[]
  connectorInstances             ConnectorInstance[]
  paymentIntents                 PaymentIntent[]
  signalForwardRequests          SignalForwardRequest[]
  humanConfirmations             HumanConfirmation[]
  radarKnownEntities             RadarKnownEntity[]
  radarMaterials                 RadarMaterial[]
  radarAnalysisRequests          RadarAnalysisRequest[]
  radarAnalysisAttempts          RadarAnalysisAttempt[]
  radarRecommendations           RadarRecommendation[]
  radarEntityAccessGrants        RadarEntityAccessGrant[]
  radarProviderCallSlots         RadarProviderCallSlot[]
  radarRecommendationEvaluations RadarRecommendationEvaluation[]

  @@index([tenantId, name])
  @@map("workspaces")
}

model User {
  id                              String                      @id @default(cuid())
  tenantId                        String                      @map("tenant_id")
  email                           String                      @unique
  displayName                     String?                     @map("display_name")
  createdAt                       DateTime                    @default(now()) @map("created_at")
  updatedAt                       DateTime                    @updatedAt @map("updated_at")
  apiTokens                       ApiToken[]
  runEvents                       RunEvent[]
  runs                            Run[]
  workspaceAgentAssignmentsSigned WorkspaceAgentAssignment[]  @relation("WorkspaceAgentAssignmentSignedBy")
  tenant                          Tenant                      @relation(fields: [tenantId], references: [id])
  productInstallationsActivated   TenantProductInstallation[] @relation("ProductInstallationActivatedBy")
  agentInstalls                   AgentInstall[]
  connectorInstances              ConnectorInstance[]
  memberships                     TenantMembership[]
  walletIdentities                WalletIdentity[]

  @@index([tenantId, email])
  @@map("users")
}

model TenantProductInstallation {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  workspaceId       String   @map("workspace_id")
  product           String
  status            String   @default("active")
  activatedAt       DateTime @default(now()) @map("activated_at")
  activatedByUserId String?  @map("activated_by_user_id")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  activatedByUser User?     @relation("ProductInstallationActivatedBy", fields: [activatedByUserId], references: [id])

  @@unique([tenantId, workspaceId, product], name: "tenant_workspace_product_unique", map: "tenant_product_installations_tenant_workspace_product_key")
  @@index([tenantId, status], map: "tenant_product_installations_tenant_status_idx")
  @@index([workspaceId, product, status], map: "tenant_product_installations_workspace_product_status_idx")
  @@map("tenant_product_installations")
}

model ApiToken {
  id          String    @id @default(cuid())
  token       String    @unique
  tenantId    String    @map("tenant_id")
  workspaceId String    @map("workspace_id")
  userId      String?   @map("user_id")
  description String?
  expiresAt   DateTime? @map("expires_at")
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, workspaceId])
  @@index([userId])
  @@map("api_tokens")
}

model GovernedCase {
  id            String                @id @default(cuid())
  tenantId      String                @map("tenant_id")
  workspaceId   String                @map("workspace_id")
  schemaVersion String                @map("schema_version")
  caseType      String                @map("case_type")
  revision      Int                   @default(1)
  lifecycle     GovernedCaseLifecycle
  subject       Json
  domainState   Json                  @map("domain_state")
  snapshot      Json
  snapshotHash  String                @map("snapshot_hash")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at")

  tenant    Tenant                 @relation(fields: [tenantId], references: [id])
  workspace Workspace              @relation(fields: [workspaceId], references: [id])
  revisions GovernedCaseRevision[]

  @@unique([id, tenantId, workspaceId], map: "governed_cases_id_scope_key")
  @@index([tenantId, workspaceId, caseType, lifecycle, updatedAt], map: "governed_cases_scope_type_lifecycle_updated_idx")
  @@map("governed_cases")
}

model GovernedCaseRevision {
  id             String                 @id @default(cuid())
  caseId         String                 @map("case_id")
  tenantId       String                 @map("tenant_id")
  workspaceId    String                 @map("workspace_id")
  revision       Int
  schemaVersion  String                 @map("schema_version")
  lifecycle      GovernedCaseLifecycle
  snapshot       Json
  snapshotHash   String                 @map("snapshot_hash")
  fromLifecycle  GovernedCaseLifecycle? @map("from_lifecycle")
  toLifecycle    GovernedCaseLifecycle  @map("to_lifecycle")
  actorType      String                 @map("actor_type")
  actorRef       String?                @map("actor_ref")
  transitionCode String                 @map("transition_code")
  createdAt      DateTime               @default(now()) @map("created_at")

  governedCase GovernedCase @relation(fields: [caseId, tenantId, workspaceId], references: [id, tenantId, workspaceId], onDelete: Restrict)

  @@unique([caseId, revision], map: "governed_case_revisions_case_revision_key")
  @@index([tenantId, workspaceId, caseId, createdAt], map: "governed_case_revisions_scope_case_created_idx")
  @@map("governed_case_revisions")
}

model Run {
  id             String            @id @default(cuid())
  tenantId       String            @map("tenant_id")
  workspaceId    String            @map("workspace_id")
  userId         String?           @map("user_id")
  caseId         String?           @map("case_id")
  threadId       String?           @map("thread_id")
  agent          String
  agentVersion   String?           @map("agent_version")
  assignmentId   String?           @map("assignment_id")
  status         RunStatus
  request        Json
  response       Json?
  costCents      Int               @default(0)
  traceId        String?
  startedAt      DateTime          @default(now())
  finishedAt     DateTime?
  errorCode      String?
  approvalStatus RunApprovalStatus @default(not_required) @map("approval_status")
  approvedBy     String?           @map("approved_by")
  approvedAt     DateTime?         @map("approved_at")
  archivedAt     DateTime?         @map("archived_at")
  archiveRef     String?           @unique @map("archive_ref")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // ⚙️ Adições necessárias para reconciliar Ledger e Runs
  criticalHash String? @map("critical_hash")
  sclTxId      String? @map("scl_tx_id")
  txId         String? @map("tx_id")

  // 🔗 Relações
  memoryEvents                      MemoryEvent[]
  events                            RunEvent[]
  guardrailLedgers                  GuardrailLedger[]
  billingLedgerEntries              BillingLedger[]
  usageBreakdowns                   RunUsageBreakdown[]
  imobCaseEvents                    ImobCaseEvent[]
  runArchive                        RunArchive?
  paymentIntents                    PaymentIntent[]
  signalForwardRequestsAsSource     SignalForwardRequest[]    @relation("SignalForwardSource")
  signalForwardRequestAsDestination SignalForwardRequest?     @relation("SignalForwardDestination")
  // Nulo até a execução real (fora desta unidade) publicar este Run — ver
  // RadarAnalysisAttempt.runId, Atualização 1.12/1.15.
  radarAnalysisAttempt              RadarAnalysisAttempt?
  assignment                        WorkspaceAgentAssignment? @relation(fields: [assignmentId], references: [id])
  tenant                            Tenant                    @relation(fields: [tenantId], references: [id])
  user                              User?                     @relation(fields: [userId], references: [id])
  workspace                         Workspace                 @relation(fields: [workspaceId], references: [id])

  // Aditiva, sem custo funcional: id já é único sozinho; esta constraint
  // composta existe apenas para permitir que outras tabelas (ex.:
  // SignalForwardRequest) referenciem Run por FK composta (id+tenant+workspace),
  // impedindo no banco um vínculo para um Run de outro tenant/workspace.
  @@unique([id, tenantId, workspaceId], name: "run_id_tenant_workspace_unique")
  @@index([tenantId, workspaceId, agent, createdAt])
  @@index([assignmentId])
  @@index([caseId])
  @@index([threadId])
  @@index([status])
  @@index([costCents])
  @@index([archivedAt])
  @@map("runs")
}

// Encaminhamento autorizado de um sinal (ex.: Radar) para a criação de um run
// em outro agente (ex.: MKT), preservando o vínculo com a origem e uma
// intenção durável de publicação, criados atomicamente com o run de destino
// (ver apps/api/src/services/signalForwarding.ts).
model SignalForwardRequest {
  id                           String   @id @default(cuid())
  tenantId                     String   @map("tenant_id")
  workspaceId                  String   @map("workspace_id")
  sourceRunId                  String   @map("source_run_id")
  destinationAgent             String   @map("destination_agent")
  idempotencyKey               String   @map("idempotency_key")
  // Calculado no servidor a partir da origem validada (ver
  // apps/api/src/services/signalForward/originContract.ts) — nunca aceito
  // do chamador. Não é a preservação do conteúdo em si (ver originSnapshot).
  requestFingerprint           String   @map("request_fingerprint")
  // Versão do algoritmo/contrato usado para calcular requestFingerprint (ver
  // FINGERPRINT_CONTRACT_VERSION em originContract.ts — fonte única, nunca
  // duplicada aqui). NÃO deriva do parsing do hash. Propositalmente SEM
  // @default: linhas pré-existentes à migration foram preenchidas uma única
  // vez no backfill (ver migration 20260908094140), com evidência de que
  // "signal-forward-fingerprint.v1" foi a única versão já usada
  // (originContract.ts introduzido uma vez em 768e1b2, constante nunca
  // mudou). Todo código novo DEVE gravar este campo explicitamente — a
  // ausência de @default faz o cliente Prisma exigir o campo em toda
  // criação, para que uma omissão futura seja um erro de tipo, não um
  // valor "v1" silencioso.
  fingerprintVersion           String   @map("fingerprint_version")
  // Cópia imutável do conteúdo da origem efetivamente usado no momento do
  // encaminhamento (não uma referência que pode mudar depois). Escrito uma
  // única vez na criação; nenhum código deste módulo o atualiza depois.
  originSnapshot               Json     @map("origin_snapshot")
  requestedByUserId            String?  @map("requested_by_user_id")
  destinationRunId             String?  @map("destination_run_id")
  status                       String   @default("pending_dispatch")
  // D6 — dois ponteiros para HumanConfirmation (registro associado, não uma
  // relação Prisma formal, mesmo padrão de requestedByUserId acima: string
  // simples, sem FK declarada). activeHumanConfirmationId é liberado/
  // substituído ao longo do tempo (nunca write-once); concludedHumanConfirmationId
  // é preenchido uma única vez, nunca reescrito depois — ver
  // CONSULTATION_ORIGIN_AUTHZ_v2.md seção 22.1/22.2 para o protocolo completo
  // de concorrência que sustenta essas duas garantias.
  activeHumanConfirmationId    String?  @map("active_human_confirmation_id")
  concludedHumanConfirmationId String?  @map("concluded_human_confirmation_id")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  workspace          Workspace           @relation(fields: [workspaceId], references: [id])
  // FK composta: garante no banco que a origem/destino pertencem ao MESMO
  // tenant/workspace deste registro — uma FK simples para Run.id não bastava
  // (não impedia referenciar um Run de outro tenant). Aditiva sobre Run.
  sourceRun          Run                 @relation("SignalForwardSource", fields: [sourceRunId, tenantId, workspaceId], references: [id, tenantId, workspaceId])
  destinationRun     Run?                @relation("SignalForwardDestination", fields: [destinationRunId, tenantId, workspaceId], references: [id, tenantId, workspaceId])
  humanConfirmations HumanConfirmation[]

  @@unique([tenantId, workspaceId, destinationAgent, idempotencyKey], name: "signalForwardIdempotencyKey")
  // Unicidade de destinationRunId preservada (equivalente à @unique simples
  // anterior, já que tenantId/workspaceId são fixos por linha) — a forma
  // composta é exigida pelo Prisma para a relação 1:1 com FK composta acima.
  @@unique([destinationRunId, tenantId, workspaceId], name: "signalForwardDestinationRunUnique")
  // Aditiva, sem custo funcional: id já é único sozinho; esta constraint
  // composta existe apenas para permitir que HumanConfirmation referencie
  // SignalForwardRequest por FK composta (id+tenant+workspace), mesmo padrão
  // já usado por run_id_tenant_workspace_unique.
  @@unique([id, tenantId, workspaceId], name: "signal_forward_request_id_tenant_workspace_unique")
  @@index([tenantId, workspaceId, sourceRunId])
  @@map("signal_forward_requests")
}

// D6 — janela de confirmação humana associada a um encaminhamento
// (SignalForwardRequest). Um encaminhamento pode ter várias, ao longo do
// tempo, mas no máximo uma ativa (SignalForwardRequest.activeHumanConfirmationId)
// e no máximo uma concluída (SignalForwardRequest.concludedHumanConfirmationId)
// — ver CONSULTATION_ORIGIN_AUTHZ_v2.md seção 22 para o desenho completo.
model HumanConfirmation {
  id                               String    @id @default(cuid())
  tenantId                         String    @map("tenant_id")
  workspaceId                      String    @map("workspace_id")
  signalForwardRequestId           String    @map("signal_forward_request_id")
  status                           String    @default("awaiting_human_completion")
  // Monotônica, começa em 0, incrementada a cada gravação de rascunho.
  // Não há histórico de revisões intermediárias — só o contador e o
  // conteúdo atual do rascunho são persistidos (seção 22.1).
  revision                         Int       @default(0)
  // Gerado uma única vez na criação da janela, por função determinística
  // (suggestedPromptGenerator.ts) — imutável depois.
  suggestedPrompt                  String    @map("suggested_prompt")
  suggestedPromptRuleVersion       String    @map("suggested_prompt_rule_version")
  humanConfirmationContractVersion String    @map("human_confirmation_contract_version")
  draftFinalPrompt                 String?   @map("draft_final_prompt")
  draftObjective                   String?   @map("draft_objective")
  draftAudience                    String?   @map("draft_audience")
  draftChannels                    Json?     @map("draft_channels")
  draftBudget                      String?   @map("draft_budget")
  draftToneProfile                 String?   @map("draft_tone_profile")
  draftToneNotes                   String?   @map("draft_tone_notes")
  draftLaunchDate                  String?   @map("draft_launch_date")
  draftDeadline                    String?   @map("draft_deadline")
  expiresAt                        DateTime  @map("expires_at")
  confirmedAt                      DateTime? @map("confirmed_at")
  confirmedByUserId                String?   @map("confirmed_by_user_id")
  // Cópia imutável de tudo exibido + preenchido no instante da confirmação
  // (radarSignal via originSnapshot do encaminhamento, suggestedPrompt+versão,
  // finalPrompt+campos de negócio, versões de contrato, confirmedByUserId,
  // confirmedAt, operationKey) — escrita uma única vez, na conclusão.
  confirmedPayloadSnapshot         Json?     @map("confirmed_payload_snapshot")
  createdAt                        DateTime  @default(now()) @map("created_at")
  updatedAt                        DateTime  @updatedAt @map("updated_at")

  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  workspace            Workspace            @relation(fields: [workspaceId], references: [id])
  // FK composta: garante no banco que esta janela pertence ao MESMO
  // tenant/workspace do encaminhamento referenciado.
  signalForwardRequest SignalForwardRequest @relation(fields: [signalForwardRequestId, tenantId, workspaceId], references: [id, tenantId, workspaceId])

  @@index([tenantId, workspaceId, signalForwardRequestId, status])
  @@map("human_confirmations")
}

// Radar Social — primeira unidade autorizada (entidade conhecida +
// recebimento autorizado de material em texto). Ver
// docs/architecture/radar-social-construction-plan-v1.md, Atualização 1.9.
// Não implementa análise, Run, fila ou chamada a modelo — só cadastro,
// consulta, recebimento e correção governados. RadarEntityAccessResolver
// real de produção está FORA desta unidade (radarEntityAccessResolver.ts
// só declara a interface); sua ausência bloqueia, por padrão, toda operação
// que dependa de acesso individual à entidade.
model RadarKnownEntity {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  workspaceId     String   @map("workspace_id")
  // Preservado exatamente como recebido (sem trim/normalização Unicode) —
  // 1–200 bytes UTF-8, ver radarKnownEntityContract.ts.
  displayName     String   @map("display_name")
  // Opaco, literal, case-sensitive — não valida CNPJ nem qualquer esquema
  // de negócio (radarKnownEntityContract.ts). Ausência/null = sem
  // referência. Único por (tenantId, workspaceId) quando preenchido —
  // UNIQUE PADRÃO abaixo, NÃO índice parcial: o Postgres já trata NULLs
  // como distintos entre si nativamente, então múltiplas linhas sem
  // externalRef convivem sem violar esta constraint.
  externalRef     String?  @map("external_ref")
  // "active" | "inactive". Inativa bloqueia NOVOS materiais (guarda de
  // nova escrita em radarMaterialService.ts), mas não bloqueia consulta ou
  // replay idempotente histórico já autorizado.
  status          String   @default("active")
  // Monotônica, incrementada pelo servidor a cada alteração bem-sucedida.
  // expectedRevision é um PARÂMETRO de chamada da operação "alterar"
  // (radarKnownEntityService.ts), não uma coluna — nunca aceito como valor
  // arbitrário deste campo.
  revision        Int      @default(0)
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant           Tenant                   @relation(fields: [tenantId], references: [id])
  workspace        Workspace                @relation(fields: [workspaceId], references: [id])
  materials        RadarMaterial[]
  analysisRequests RadarAnalysisRequest[]
  accessGrants     RadarEntityAccessGrant[]

  // Chave composta referenciável — permite que RadarMaterial se vincule à
  // MESMA entidade/tenant/workspace por FK composta (mesmo padrão já usado
  // por signal_forward_request_id_tenant_workspace_unique).
  @@unique([id, tenantId, workspaceId], name: "radar_known_entity_id_tenant_workspace_unique")
  @@unique([tenantId, workspaceId, externalRef], name: "radar_known_entity_external_ref_unique")
  @@index([tenantId, workspaceId, status])
  @@map("radar_known_entities")
}

// Material em texto vinculado a uma RadarKnownEntity. Imutável depois de
// criado: uma correção nunca sobrescreve — cria uma sucessora nova que
// aponta de volta via supersedesMaterialId (no máximo uma sucessora por
// predecessor).
model RadarMaterial {
  id                   String    @id @default(cuid())
  tenantId             String    @map("tenant_id")
  workspaceId          String    @map("workspace_id")
  entityId             String    @map("entity_id")
  // Preservado byte a byte como recebido — sem trim, sem normalização
  // Unicode, sem alteração de quebra de linha. 1–16.384 bytes UTF-8
  // (radarMaterialContract.ts).
  conteudo             String
  // SHA-256 hex sobre os bytes UTF-8 exatos de `conteudo`, calculado pelo
  // servidor — nunca aceito do corpo. Não autentica a fonte nem substitui
  // a comparação completa da identidade da solicitação (só identifica o
  // conteúdo em si, para fins de diagnóstico/dedup por conteúdo).
  hashDoMaterial       String    @map("hash_do_material")
  fonteDeclarada       String    @map("fonte_declarada")
  // DATE real (YYYY-MM-DD, calendário válido), granularidade de dia, sem
  // horário. Ausência/null são equivalentes; string vazia é rejeitada
  // antes de chegar aqui (radarMaterialContract.ts).
  capturadoEm          DateTime? @map("capturado_em") @db.Date
  // Predecessor corrigido por este material, quando este é uma correção.
  // null = criação nova (não uma correção) — participa da comparação de
  // identidade da solicitação como qualquer outro campo, nunca ignorado
  // (correção da Atualização 1.9 do plano).
  supersedesMaterialId String?   @map("supersedes_material_id")
  // Token de deduplicação do CHAMADOR, único por (tenantId, workspaceId) —
  // decisão deliberada de NÃO incluir entityId nesta chave: uma tentativa
  // com o mesmo operationKey mas entityId diferente colide na constraint e
  // é então classificada como CONFLITO pela comparação de identidade
  // completa (radarMaterialService.ts), nunca como duas linhas
  // independentes silenciosamente aceitas.
  operationKey         String    @map("operation_key")
  // Identidade autenticada de quem forneceu/associou o material a esta
  // entidade nesta unidade — ver radarMaterialContract.ts: nesta unidade
  // providedByUserId e "associatedByUserId" são sempre o mesmo usuário; uma
  // coluna separada para a segunda seria capacidade nova não autorizada.
  providedByUserId     String    @map("provided_by_user_id")
  // Gerado pelo servidor a cada tentativa, inclusive replays — nunca entra
  // na comparação de identidade da solicitação.
  recebidoEm           DateTime  @default(now()) @map("recebido_em")

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  workspace        Workspace              @relation(fields: [workspaceId], references: [id])
  // FK composta: garante que o material pertence à MESMA entidade/tenant/
  // workspace referenciados — não apenas a um id de entidade solto.
  entity           RadarKnownEntity       @relation(fields: [entityId, tenantId, workspaceId], references: [id, tenantId, workspaceId])
  // Auto-relação 1:1: o predecessor só pode estar na MESMA
  // entidade/tenant/workspace (FK composta de 4 colunas) — nunca apenas no
  // mesmo tenant/workspace.
  predecessor      RadarMaterial?         @relation("RadarMaterialSuccession", fields: [supersedesMaterialId, tenantId, workspaceId, entityId], references: [id, tenantId, workspaceId, entityId])
  successor        RadarMaterial?         @relation("RadarMaterialSuccession")
  analysisRequests RadarAnalysisRequest[]

  // Chave composta referenciável (inclui entityId) para a FK do predecessor
  // acima — reforça no banco que sucessora e predecessora nunca trocam de
  // entidade.
  @@unique([id, tenantId, workspaceId, entityId], name: "radar_material_id_tenant_workspace_entity_unique")
  @@unique([tenantId, workspaceId, operationKey], name: "radar_material_operation_key_unique")
  // UNIQUE PADRÃO (não índice parcial), nos mesmos 4 campos da FK acima —
  // garante no máximo uma sucessora por predecessor. Múltiplas linhas com
  // supersedesMaterialId=NULL (criações novas) convivem porque o Postgres
  // trata NULLs como distintos entre si.
  @@unique([supersedesMaterialId, tenantId, workspaceId, entityId], name: "radar_material_predecessor_successor_unique")
  @@index([tenantId, workspaceId, entityId])
  @@map("radar_materials")
}

// Radar Social — segunda unidade: solicitação de análise, tentativa de
// execução governada e recomendação fundamentada persistida. Ver
// docs/architecture/radar-social-construction-plan-v1.md, Atualizações
// 1.11 a 1.18. Executor/provedor são substitutos controlados nesta
// unidade — nenhuma chamada real a modelo, nenhum Run publicado em fila.
model RadarAnalysisRequest {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  workspaceId       String   @map("workspace_id")
  entityId          String   @map("entity_id")
  materialId        String   @map("material_id")
  // Preservado exatamente como recebido — 1–2.000 bytes UTF-8
  // (radarAnalysisRequestContract.ts).
  objective         String
  // Opcional. Ausência e null equivalentes ("sem contexto adicional");
  // quando presente, 1–8.000 bytes UTF-8, mesmas rejeições de `objective`.
  additionalContext String?  @map("additional_context")
  // Do contexto confiável, nunca do corpo.
  requestedByUserId String   @map("requested_by_user_id")
  // Chave de idempotência da SOLICITAÇÃO — identidade completa comparada
  // sob a mesma chave: {entityId, materialId, objective, additionalContext,
  // requestedByUserId} (Atualização 1.11/1.14).
  operationKey      String   @map("operation_key")
  createdAt         DateTime @default(now()) @map("created_at")

  tenant    Tenant                 @relation(fields: [tenantId], references: [id])
  workspace Workspace              @relation(fields: [workspaceId], references: [id])
  // FK composta: garante que a entidade referenciada pertence ao MESMO
  // tenant/workspace.
  entity    RadarKnownEntity       @relation(fields: [entityId, tenantId, workspaceId], references: [id, tenantId, workspaceId])
  // FK composta de 4 colunas: garante que o material referenciado pertence
  // à MESMA entidade/tenant/workspace desta solicitação — não apenas a um
  // id de material solto (mesmo padrão de RadarMaterial.predecessor).
  material  RadarMaterial          @relation(fields: [materialId, tenantId, workspaceId, entityId], references: [id, tenantId, workspaceId, entityId])
  attempts  RadarAnalysisAttempt[]

  @@unique([id, tenantId, workspaceId], name: "radar_analysis_request_id_tenant_workspace_unique")
  @@unique([tenantId, workspaceId, operationKey], name: "radar_analysis_request_operation_key_unique")
  @@index([tenantId, workspaceId, entityId])
  @@map("radar_analysis_requests")
}

// Tentativa de execução de uma RadarAnalysisRequest. Estados:
// pending -> running -> provider_responded_pending_persistence -> completed,
// com saída para failed a partir de running/provider_responded_pending_persistence,
// e cancelled só por decisão humana explícita a partir de pending/running
// (Atualização 1.12/1.15/1.18). claimToken protege a EXECUÇÃO de uma linha
// já existente; attemptOperationKey protege a CRIAÇÃO da linha em si —
// lacunas distintas, nunca confundidas (Atualização 1.18).
model RadarAnalysisAttempt {
  id                               String    @id @default(cuid())
  tenantId                         String    @map("tenant_id")
  workspaceId                      String    @map("workspace_id")
  analysisRequestId                String    @map("analysis_request_id")
  // Único sob (tenantId, workspaceId, analysisRequestId,
  // attemptOperationKey) — protege a criação da tentativa contra reenvio
  // duplicado e contra duas criações concorrentes (Atualização 1.18).
  attemptOperationKey              String    @map("attempt_operation_key")
  attemptNumber                    Int       @map("attempt_number")
  status                           String    @default("pending")
  // Posse de execução — claimedAt + TTL do serviço determina expiração,
  // verificada sempre via clock_timestamp() no banco (Atualização 1.18),
  // nunca pelo relógio da aplicação.
  claimedByWorkerId                String?   @map("claimed_by_worker_id")
  claimToken                       String?   @map("claim_token")
  claimedAt                        DateTime? @map("claimed_at")
  // Nulo até a execução real (fora desta unidade) publicar um Run de fato.
  runId                            String?   @map("run_id")
  cancelRequestedAt                DateTime? @map("cancel_requested_at")
  failureReasonCode                String?   @map("failure_reason_code")
  // Configuração SOLICITADA, de origem exclusiva do servidor, congelada no
  // nascimento da tentativa — nunca recalculada depois (Atualização
  // 1.16/1.17/1.18). Campos fechados definidos em
  // radarAnalysisAttemptContract.ts, validados antes de gravar aqui.
  generationConfig                 Json      @map("generation_config")
  // Resultado estruturado intermediário (candidato a RadarRecommendation,
  // antes da validação de referências) — preservação durável própria do
  // Radar, não RunEvent (Atualização 1.15). Limite de 32.768 bytes UTF-8
  // sobre a serialização não-canônica (ordem de inserção), medido antes de
  // gravar (Atualização 1.16/1.17/1.18).
  preservedResultPayload           Json?     @map("preserved_result_payload")
  // SHA-256 hex sobre a serialização determinística (chaves ordenadas) do
  // payload acima — nunca sobre a linha inteira, nunca circular.
  preservedResultHash              String?   @map("preserved_result_hash")
  preservedResultVersion           String?   @map("preserved_result_version")
  preservedResultProvider          String?   @map("preserved_result_provider")
  preservedResultModel             String?   @map("preserved_result_model")
  preservedResultProviderRequestId String?   @map("preserved_result_provider_request_id")
  preservedAt                      DateTime? @map("preserved_at")
  createdAt                        DateTime  @default(now()) @map("created_at")
  updatedAt                        DateTime  @updatedAt @map("updated_at")

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  workspace        Workspace              @relation(fields: [workspaceId], references: [id])
  analysisRequest  RadarAnalysisRequest   @relation(fields: [analysisRequestId, tenantId, workspaceId], references: [id, tenantId, workspaceId])
  // FK composta opcional para o Run real, quando/se a execução real vier a
  // publicá-lo (fora desta unidade). 1:1 — um Run pertence, no máximo, a
  // uma tentativa.
  run              Run?                   @relation(fields: [runId, tenantId, workspaceId], references: [id, tenantId, workspaceId])
  recommendation   RadarRecommendation?
  providerCallSlot RadarProviderCallSlot?

  @@unique([id, tenantId, workspaceId], name: "radar_analysis_attempt_id_tenant_workspace_unique")
  @@unique([tenantId, workspaceId, analysisRequestId, attemptOperationKey], name: "radar_analysis_attempt_operation_key_unique")
  @@unique([runId, tenantId, workspaceId], name: "radar_analysis_attempt_run_unique")
  @@index([tenantId, workspaceId, analysisRequestId, status])
  @@map("radar_analysis_attempts")
}

// Recomendação fundamentada, 1:1 com a tentativa que a produziu. Imutável
// depois de criada — uma nova tentativa (nunca uma edição) produziria uma
// RadarRecommendation nova, vinculada a si mesma (Atualização 1.12/1.15).
model RadarRecommendation {
  id                         String   @id @default(cuid())
  tenantId                   String   @map("tenant_id")
  workspaceId                String   @map("workspace_id")
  attemptId                  String   @map("attempt_id")
  // "actionable" | "insufficient_evidence" | "do_not_act" — os três são
  // resultados VÁLIDOS, nenhum equivalente a falha técnica (Atualização
  // 1.11/1.12).
  recommendationType         String   @map("recommendation_type")
  summary                    String
  // Array de {content, natureza, referenceIds[], confidenceLevel?} — ver
  // radarRecommendationContract.ts. natureza e confidenceLevel são
  // dimensões INDEPENDENTES, nunca fundidas (Atualização 1.11 seção B).
  statements                 Json
  // Array de referências já validadas deterministicamente contra o
  // material/contexto antes de esta linha existir — localização/estrutura
  // confirmadas, NUNCA prova de veracidade ou sustentação semântica
  // completa (Atualização 1.12/1.17).
  references                 Json
  limitations                String?
  suggestedAction            String?  @map("suggested_action")
  insufficientEvidenceReason String?  @map("insufficient_evidence_reason")
  doNotActReason             String?  @map("do_not_act_reason")
  // {generatedByAgent, model, provider, requestId, generatedAt} — valores
  // REAIS devolvidos pelo executor, nunca inventados.
  provenance                 Json
  createdAt                  DateTime @default(now()) @map("created_at")

  tenant      Tenant                          @relation(fields: [tenantId], references: [id])
  workspace   Workspace                       @relation(fields: [workspaceId], references: [id])
  attempt     RadarAnalysisAttempt            @relation(fields: [attemptId, tenantId, workspaceId], references: [id, tenantId, workspaceId])
  evaluations RadarRecommendationEvaluation[]

  @@unique([attemptId, tenantId, workspaceId], name: "radar_recommendation_attempt_unique")
  // Aditivo (avaliação humana persistida) — necessário como lado referenciado
  // da FK composta de RadarRecommendationEvaluation.recommendation; `id`
  // isolado já era único, esta constraint só formaliza a tripla exigida pelo
  // Postgres para uma FK composta (mesma técnica já usada em
  // RadarAnalysisAttempt/RadarMaterial). Nenhuma coluna nova, nenhum dado
  // existente afetado.
  @@unique([id, tenantId, workspaceId], name: "radar_recommendation_id_tenant_workspace_unique")
  @@index([tenantId, workspaceId])
  @@map("radar_recommendations")
}

// Avaliação humana persistida de uma RadarRecommendation — nunca uma decisão
// operacional. Vínculo com o objeto avaliado é só `recommendationId`: a
// cadeia RadarRecommendation -> attemptId -> generationConfig é imutável por
// construção (nenhuma chamada a `.update()`/`.upsert()` sobre
// RadarRecommendation existe em todo `radarSocial`), então nenhum hash ou
// snapshot adicional é necessário. Essa imutabilidade é uma propriedade do
// CÓDIGO da aplicação, não uma proibição imposta pelo banco (não há trigger
// nem CHECK constraint aqui) — nunca escrever nesta tabela via UPDATE é
// requisito desta unidade, não uma garantia estrutural do Postgres.
//
// Imutável do mesmo jeito: uma correção é sempre uma linha NOVA ligada por
// `supersedesEvaluationId`, nunca uma reescrita da linha original — mesma
// técnica de RadarMaterial.supersedesMaterialId. `criteriaVersion` é fixada
// no servidor na criação e NUNCA recalculada num reenvio (ver
// radarRecommendationEvaluationContract.ts / radarRecommendationEvaluationService.ts) —
// uma atualização da rubrica vigente depois da criação nunca, sozinha,
// invalida ou entra em conflito com um reenvio idempotente da mesma
// avaliação.
model RadarRecommendationEvaluation {
  id                     String   @id @default(cuid())
  tenantId               String   @map("tenant_id")
  workspaceId            String   @map("workspace_id")
  // Versão do FORMATO deste registro (radarRecommendationEvaluationContract.ts,
  // RADAR_RECOMMENDATION_EVALUATION_CONTRACT_VERSION) — nunca o significado
  // dos valores de enum, versionado separadamente por criteriaVersion.
  contractVersion        String   @map("contract_version")
  recommendationId       String   @map("recommendation_id")
  // Identidade AUTENTICADA de quem avaliou — nunca aceita do corpo
  // (radarRecommendationEvaluationService.ts sempre usa actorUserId do
  // contexto de operação, nunca um campo livre do chamador).
  evaluatorUserId        String   @map("evaluator_user_id")
  // Chave do mapa RADAR_RECOMMENDATION_EVALUATION_RUBRICS vigente NO MOMENTO
  // DA CRIAÇÃO desta linha — fixada uma única vez, nunca recalculada num
  // reenvio idempotente. Entradas do mapa são aditivas (nunca editadas em
  // código depois de publicadas): uma avaliação antiga permanece
  // interpretável pela sua própria versão, mesmo que rubricas futuras mudem
  // o significado dos mesmos rótulos de enum.
  criteriaVersion        String   @map("criteria_version")
  // bem_fundamentada | parcialmente_fundamentada | nao_fundamentada | nao_avaliavel
  fundamentacao          String
  // clara | parcialmente_clara | confusa | nao_avaliavel
  clareza                String
  // util | parcialmente_util | nao_util | nao_avaliavel
  utilidade              String
  // Obrigatória quando fundamentacao/clareza/utilidade não são
  // simultaneamente o valor totalmente positivo, ou quando qualquer um é
  // nao_avaliavel — regra pertence à rubrica (criteriaVersion), nunca
  // recalculada com uma rubrica diferente da que gerou esta linha.
  justificativa          String?
  comentario             String?
  // Predecessor corrigido por esta linha, quando esta é uma correção. null =
  // avaliação raiz (não uma correção) — participa da comparação de
  // identidade da solicitação como qualquer outro campo, nunca ignorado.
  supersedesEvaluationId String?  @map("supersedes_evaluation_id")
  // Token de deduplicação do CHAMADOR, único por (tenantId, workspaceId,
  // recommendationId, evaluatorUserId) — cada par (recomendação, avaliador)
  // tem seu próprio namespace, não um namespace global por workspace.
  operationKey           String   @map("operation_key")
  // Gerado pelo servidor SÓ na inserção — nunca reescrito por um reenvio
  // idempotente nem por uma correção (a correção cria uma linha nova, com
  // seu próprio createdAt; a linha original mantém o dela para sempre).
  createdAt              DateTime @default(now()) @map("created_at")

  tenant         Tenant                         @relation(fields: [tenantId], references: [id])
  workspace      Workspace                      @relation(fields: [workspaceId], references: [id])
  recommendation RadarRecommendation            @relation(fields: [recommendationId, tenantId, workspaceId], references: [id, tenantId, workspaceId])
  // Auto-relação 1:1: predecessora e sucessora nunca trocam de recomendação
  // ou de avaliador (FK composta de 5 colunas) — mesma técnica de
  // RadarMaterial.predecessor/successor.
  predecessor    RadarRecommendationEvaluation? @relation("RadarRecommendationEvaluationSuccession", fields: [supersedesEvaluationId, tenantId, workspaceId, recommendationId, evaluatorUserId], references: [id, tenantId, workspaceId, recommendationId, evaluatorUserId])
  successor      RadarRecommendationEvaluation? @relation("RadarRecommendationEvaluationSuccession")

  // Chave composta referenciável (inclui recommendationId e evaluatorUserId)
  // para a FK do predecessor acima — reforça no banco que sucessora e
  // predecessora nunca trocam de recomendação nem de avaliador.
  @@unique([id, tenantId, workspaceId, recommendationId, evaluatorUserId], name: "radar_recommendation_evaluation_id_full_unique")
  @@unique([tenantId, workspaceId, recommendationId, evaluatorUserId, operationKey], name: "radar_recommendation_evaluation_operation_key_unique")
  // UNIQUE PADRÃO (não índice parcial), nos mesmos 4 campos da FK acima —
  // garante no máximo uma sucessora por predecessora. Múltiplas linhas com
  // supersedesEvaluationId=NULL (avaliações raiz) convivem porque o
  // Postgres trata NULLs como distintos entre si — a restrição de "no
  // máximo uma RAIZ por (recomendação, avaliador)" é um índice único
  // PARCIAL adicional, editado manualmente na migration gerada (mesma
  // técnica de radar_analysis_attempts_one_active_per_request), não
  // expressável neste schema.prisma.
  @@unique([supersedesEvaluationId, tenantId, workspaceId, recommendationId, evaluatorUserId], name: "radar_recommendation_evaluation_succession_unique")
  @@index([tenantId, workspaceId, recommendationId])
  @@map("radar_recommendation_evaluations")
}

// Concessão/revogação de acesso individual a uma RadarKnownEntity, por
// operação (read|write|manage|analyze — mesmos quatro valores de
// RadarEntityAccessInput.operation, radarEntityAccessResolver.ts, nenhum
// novo introduzido). Uma linha por (entidade, usuário, operação); "enabled"
// é o estado ATUAL (toggle idempotente, mesmo padrão de
// WorkspaceAgentAssignment) — reconceder depois de revogar reativa a MESMA
// linha, nunca cria uma segunda. Histórico de transições passadas vive em
// GuardrailAuditLedger (reaproveitado, sem tabela nova além desta), nunca
// nesta linha (Atualização 1.22 Decisão 3a / 1.25).
//
// Sem bypass implícito para o criador da entidade (Atualização 1.22 Decisão
// 1, corrigindo a Atualização 1.21): os grants do criador são linhas reais,
// criadas atomicamente com a entidade por createRadarKnownEntity, revogáveis
// como quaisquer outras.
model RadarEntityAccessGrant {
  id              String    @id @default(cuid())
  tenantId        String    @map("tenant_id")
  workspaceId     String    @map("workspace_id")
  entityId        String    @map("entity_id")
  granteeUserId   String    @map("grantee_user_id")
  operation       String
  enabled         Boolean   @default(true)
  grantedByUserId String    @map("granted_by_user_id")
  grantedAt       DateTime  @map("granted_at")
  revokedByUserId String?   @map("revoked_by_user_id")
  revokedAt       DateTime? @map("revoked_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  workspace Workspace        @relation(fields: [workspaceId], references: [id])
  entity    RadarKnownEntity @relation(fields: [entityId, tenantId, workspaceId], references: [id, tenantId, workspaceId])

  @@unique([tenantId, workspaceId, entityId, granteeUserId, operation], name: "radar_entity_access_grant_unique")
  @@index([tenantId, workspaceId, entityId, granteeUserId, enabled])
  @@map("radar_entity_access_grants")
}

// Controle de CONCORRÊNCIA das chamadas reais do Radar por
// (tenantId, workspaceId) — NUNCA reserva financeira, de tokens ou de
// orçamento; só conta vagas ocupadas por tentativas em voo. Uma linha por
// RadarAnalysisAttempt (nunca duas para a mesma tentativa — idempotente).
// "released" é o único jeito de liberar uma vaga, e só acontece quando o
// desfecho é CONHECIDO (resposta durável obtida, ou falha comprovadamente
// anterior ao envio) — nunca por timeout nem por perda de posse do
// trabalhador (Atualização 1.32 do plano).
model RadarProviderCallSlot {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  workspaceId String    @map("workspace_id")
  attemptId   String    @map("attempt_id")
  status      String    @default("occupied")
  occupiedAt  DateTime  @map("occupied_at")
  releasedAt  DateTime? @map("released_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  workspace Workspace            @relation(fields: [workspaceId], references: [id])
  attempt   RadarAnalysisAttempt @relation(fields: [attemptId, tenantId, workspaceId], references: [id, tenantId, workspaceId])

  @@unique([attemptId, tenantId, workspaceId], name: "radar_provider_call_slot_attempt_unique")
  @@index([tenantId, workspaceId, status])
  @@map("radar_provider_call_slots")
}

model RunArchive {
  id          String   @id @default(cuid())
  runId       String   @unique @map("run_id")
  tenantId    String   @map("tenant_id")
  workspaceId String   @map("workspace_id")
  archiveRef  String   @unique @map("archive_ref")
  archivedAt  DateTime @map("archived_at")
  snapshot    Json
  createdAt   DateTime @default(now()) @map("created_at")

  run       Run       @relation(fields: [runId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, workspaceId, archivedAt], map: "run_archives_tenant_workspace_archived_at_idx")
  @@map("run_archives")
}

model RunEvent {
  id           String    @id @default(cuid())
  runId        String    @map("run_id")
  tenantId     String    @map("tenant_id")
  workspaceId  String    @map("workspace_id")
  userId       String?   @map("user_id")
  type         String
  payload      Json?
  criticalHash String?   @map("critical_hash")
  sclTxId      String?   @map("scl_tx_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  run          Run       @relation(fields: [runId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  user         User?     @relation(fields: [userId], references: [id])
  workspace    Workspace @relation(fields: [workspaceId], references: [id])

  @@index([runId, createdAt])
  @@index([tenantId, workspaceId, createdAt])
  @@map("run_events")
}

model PlanStepRecord {
  id          String   @id @default(cuid())
  runId       String
  tenantId    String
  workspaceId String
  stepIndex   Int
  stepType    String
  input       Json?
  output      Json?
  createdAt   DateTime @default(now())

  @@index([runId])
}

model PlanQuota {
  projectId       String   @id
  softLimitCents  Int
  hardLimitCents  Int
  monthUsageCents Int      @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("plan_quotas")
}

model Pricing {
  id          String   @id @default(cuid())
  agent       String
  perRunCents Int      @default(0)
  perMBcents  Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  // 🔹 Relação inversa com AgentMetadata
  agentMetadata AgentMetadata? @relation("AgentPricing")

  @@index([agent, active])
  @@map("pricing")
}

model AgentProfile {
  id           String   @id @default(cuid())
  agent        String   @unique
  name         String
  description  String?
  model        String
  systemPrompt String
  tools        Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("agent_profiles")
}

model PaymentTx {
  id          String        @id @default(cuid())
  projectId   String
  provider    String
  externalId  String
  amountCents Int
  status      PaymentStatus
  createdAt   DateTime      @default(now())

  @@index([projectId, createdAt])
  @@map("payment_tx")
}

model UploadedDocument {
  id          String    @id @default(cuid())
