  @@index([tenantId, workspaceId, stage], map: "imob_leads_tenant_workspace_stage_idx")
  @@index([tenantId, workspaceId, temperature], map: "imob_leads_tenant_workspace_temperature_idx")
  @@map("imob_leads")
}

model ImobCase {
  id               String              @id @default(cuid())
  tenantId         String              @map("tenant_id")
  workspaceId      String              @map("workspace_id")
  threadId         String?             @map("thread_id")
  flow             String
  stage            String
  status           String
  ownerResponsible String?             @map("owner_responsible")
  nextStep         String?             @map("next_step")
  blockers         Json?
  pendingItems     Json?               @map("pending_items")
  ownerId          String?             @map("owner_id")
  propertyId       String?             @map("property_id")
  leadId           String?             @map("lead_id")
  externalDealId   String?             @map("external_deal_id")
  metadata         Json?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at")
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  workspace        Workspace           @relation(fields: [workspaceId], references: [id])
  owner            ImobOwner?          @relation(fields: [ownerId], references: [id])
  property         ImobProperty?       @relation(fields: [propertyId], references: [id])
  lead             ImobLead?           @relation(fields: [leadId], references: [id])
  events           ImobCaseEvent[]
  marketScanRuns   ImobMarketScanRun[]

  @@index([tenantId, workspaceId, createdAt], map: "imob_cases_tenant_workspace_created_at_idx")
  @@index([tenantId, workspaceId, flow, status], map: "imob_cases_tenant_workspace_flow_status_idx")
  @@index([tenantId, workspaceId, stage], map: "imob_cases_tenant_workspace_stage_idx")
  @@index([threadId])
  @@index([ownerId])
  @@index([propertyId])
  @@index([leadId])
  @@map("imob_cases")
}

model ImobMarketScanRun {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  workspaceId      String    @map("workspace_id")
  caseId           String?   @map("case_id")
  query            Json
  region           String?
  operation        String?
  propertyType     String?   @map("property_type")
  requestedAt      DateTime  @map("requested_at")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  status           String
  accessMode       String?   @map("access_mode")
  sourceIds        Json      @map("source_ids")
  termsMode        String?   @map("terms_mode")
  queryHash        String    @map("query_hash")
  evidenceBundleId String?   @map("evidence_bundle_id")
  resultSnapshot   Json?     @map("result_snapshot")
  recommendationId String?   @map("recommendation_id")
  opportunityId    String?   @map("opportunity_id")
  failureReason    String?   @map("failure_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  imobCase  ImobCase? @relation(fields: [caseId], references: [id])

  @@index([tenantId, workspaceId, requestedAt], map: "imob_market_scan_runs_tenant_workspace_requested_at_idx")
  @@index([tenantId, workspaceId, status], map: "imob_market_scan_runs_tenant_workspace_status_idx")
  @@index([caseId])
  @@index([queryHash])
  @@map("imob_market_scan_runs")
}

model ImobCaseEvent {
  id          String    @id @default(cuid())
  caseId      String    @map("case_id")
  tenantId    String    @map("tenant_id")
  workspaceId String    @map("workspace_id")
  runId       String?   @map("run_id")
  type        String
  actorType   String    @map("actor_type")
  actorRef    String?   @map("actor_ref")
  summary     String
  evidenceRef String?   @map("evidence_ref")
  payload     Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  imobCase    ImobCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  run         Run?      @relation(fields: [runId], references: [id])

  @@index([caseId, createdAt])
  @@index([tenantId, workspaceId, createdAt], map: "imob_case_events_tenant_workspace_created_at_idx")
  @@index([runId])
  @@map("imob_case_events")
}

