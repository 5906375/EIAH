model AgentInstall {
  id                String   @id
  tenantId          String   @map("tenant_id")
  workspaceId       String   @map("workspace_id")
  agentSlug         String   @map("agent_slug")
  installedByUserId String?  @map("installed_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  installedBy User?     @relation(fields: [installedByUserId], references: [id])

  @@map("agent_installs")
}

model AgentReputation {
  id               String   @id
  tenantId         String   @map("tenant_id")
  workspaceId      String   @map("workspace_id")
  agentId          String   @map("agent_id")
  completedRuns    Int      @default(0) @map("completed_runs")
  disputesTotal    Int      @default(0) @map("disputes_total")
  disputeRate      Float    @default(0) @map("dispute_rate")
  trustScore       Int      @default(100) @map("trust_score")
  verifiedReceipts Int      @default(0) @map("verified_receipts")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @map("updated_at")

  @@unique([tenantId, workspaceId, agentId], map: "agent_reputation_tenant_workspace_agent_unique")
  @@index([tenantId, workspaceId], map: "agent_reputation_tenant_workspace_idx")
  @@map("agent_reputation")
}

model AgentReputationEvent {
  id          String   @id
  eventKey    String   @unique @map("event_key")
  tenantId    String   @map("tenant_id")
  workspaceId String   @map("workspace_id")
  agentId     String   @map("agent_id")
  eventType   String   @map("event_type")
  payload     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("agent_reputation_events")
}

model ApprovalRecord {
  id              String           @id
  runId           String?          @map("run_id")
  tenantId        String           @map("tenant_id")
  workspaceId     String           @map("workspace_id")
  decidedByUserId String?          @map("decided_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  decision        ApprovalDecision

  @@map("approval_records")
}

model BillingDispute {
  id              String    @id
  tenantId        String    @map("tenant_id")
  workspaceId     String    @map("workspace_id")
  paymentIntentId String    @map("payment_intent_id")
  runId           String    @map("run_id")
  agentId         String    @map("agent_id")
  status          String    @default("open")
  reason          String?
  resolution      String?
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")
  closedAt        DateTime? @map("closed_at")

  @@index([paymentIntentId], map: "billing_disputes_payment_intent_idx")
  @@index([tenantId, workspaceId, status], map: "billing_disputes_tenant_workspace_status_idx")
  @@map("billing_disputes")
}

model BillingWebhookEvent {
  id              String         @id
  provider        String
  eventId         String         @map("event_id")
  paymentIntentId String?        @map("payment_intent_id")
  tenantId        String?        @map("tenant_id")
  workspaceId     String?        @map("workspace_id")
  status          String         @default("accepted")
  signatureHash   String?        @map("signature_hash")
  payloadHash     String?        @map("payload_hash")
  createdAt       DateTime       @default(now()) @map("created_at")
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id], map: "billing_webhook_events_payment_intent_fkey")

  @@unique([provider, eventId], map: "billing_webhook_events_provider_event_unique")
  @@index([tenantId, createdAt], map: "billing_webhook_events_tenant_created_idx")
  @@map("billing_webhook_events")
}

model ConnectorInstance {
  id              String   @id
  tenantId        String   @map("tenant_id")
  workspaceId     String   @map("workspace_id")
  connector       String
  config          Json?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  createdBy User?     @relation(fields: [createdByUserId], references: [id])

  @@map("connector_instances")
}

model PaymentIntent {
  id                String                @id
  tenantId          String                @map("tenant_id")
  workspaceId       String                @map("workspace_id")
  runId             String                @map("run_id")
  amountCents       Int                   @map("amount_cents")
  currency          String                @default("BRL")
  status            String                @default("pending")
  provider          String?
  requestId         String                @map("request_id")
  externalId        String?               @map("external_id")
  settlementReceipt Json?                 @map("settlement_receipt")
  metadata          Json?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @default(now()) @map("updated_at")
  webhookEvents     BillingWebhookEvent[]

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run       Run       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([tenantId, requestId], map: "payment_intents_tenant_request_unique")
  @@index([provider, status])
  @@index([tenantId, workspaceId, status], map: "payment_intents_tenant_workspace_status_idx")
  @@map("payment_intents")
}

model ProofOfUsage {
  id            String            @id
  runId         String            @map("run_id")
  tenantId      String            @map("tenant_id")
  workspaceId   String            @map("workspace_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @default(now()) @map("updated_at")
  status        PoUStatus         @default(PENDING)
  failureReason PoUFailureReason? @map("failure_reason")

  @@map("proof_of_usage")
}

model RolePermission {
  id         String           @id
  roleId     String           @map("role_id")
  permission String
  createdAt  DateTime         @default(now()) @map("created_at")
  role       TenantCustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("role_permissions")
}

model RunExecutionLock {
  id          String   @id
  tenantId    String   @map("tenant_id")
  workspaceId String   @map("workspace_id")
  runId       String   @map("run_id")
  holderId    String   @map("holder_id")
  expiresAt   DateTime @map("expires_at")

  @@unique([tenantId, workspaceId, runId])
  @@map("run_execution_locks")
}

model TenantMembership {
  id           String   @id
  tenantId     String   @map("tenant_id")
  userId       String   @map("user_id")
  role         String   @default("member")
  customRoleId String?  @map("custom_role_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @map("updated_at")

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  user       User              @relation(fields: [userId], references: [id])
  customRole TenantCustomRole? @relation(fields: [customRoleId], references: [id])

  @@map("tenant_memberships")
}

model TenantCustomRole {
  id          String             @id
  tenantId    String             @map("tenant_id")
  name        String
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @map("updated_at")
  permissions RolePermission[]
  memberships TenantMembership[]
  tenant      Tenant             @relation(fields: [tenantId], references: [id])

  @@map("tenant_role_customs")
}

model WalletIdentity {
  id            String   @id
  userId        String   @map("user_id")
  tenantId      String   @map("tenant_id")
  walletAddress String   @map("wallet_address")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@map("wallet_identities")
}
