{
  "name": "@repo/db",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "prisma"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/generated/client/index.d.ts",
      "import": "./dist/generated/client/index.js",
      "default": "./dist/generated/client/index.js"
    },
    "./generated/client": {
      "types": "./dist/generated/client/index.d.ts",
      "import": "./dist/generated/client/index.js",
      "default": "./dist/generated/client/index.js"
    },
    "./generated/client/*": {
      "types": "./dist/generated/client/*",
      "import": "./dist/generated/client/*",
      "default": "./dist/generated/client/*"
    }
  },
  "scripts": {
    "prisma": "prisma",
    "generate": "pnpm prisma generate",
    "migrate:dev": "pnpm prisma migrate dev",
    "migrate:deploy": "pnpm prisma migrate deploy",
    "studio": "pnpm prisma studio",
    "build:dts": "tsc --build tsconfig.json --force",
    "build": "pnpm run generate && tsup --config tsup.config.ts && pnpm run build:dts",
    "postbuild": "node ./scripts/copy-publish-artifacts.mjs",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "prepare": "pnpm run build",
    "prebuild": "bash ../../scripts/prebuild-check.sh"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.2.0",
    "@prisma/client": "7.2.0",
    "@prisma/client-runtime-utils": "7.2.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@prisma/config": "^7.1.0",
    "@types/node": "25.0.3",
    "prisma": "7.2.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "fs-extra": "^11.2.0"
  }
}
