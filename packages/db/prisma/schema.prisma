generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  engineType    = "binary"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// 🧠 Enums — Execução e Pagamentos
// (necessários para validação e índices)
// ========================================

enum RunStatus {
  pending
  running
  success
  error
  blocked
  awaiting_approval
}

enum RunApprovalStatus {
  not_required
  pending
  approved
  rejected
}

enum PaymentStatus {
  pending
  succeeded
  failed
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum PoUFailureReason {
  DB_WRITE_FAILED
  VALIDATION_ERROR
  SIGNER_ERROR
  OUTPUT_UNAVAILABLE
  HASH_ERROR
  ATTESTATION_FAILED
  UNKNOWN
}

enum PoUStatus {
  PENDING
  FINALIZED
  FAILED
  PENDING_TRUST
}

model Tenant {
  id                        String                      @id @default(cuid())
  name                      String
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  apiTokens                 ApiToken[]
  embeddingChunks           EmbeddingChunk[]
  guardrailLedger           GuardrailLedger[]
  memoryEvents              MemoryEvent[]
  memorySnapshots           MemorySnapshot[]
  runEvents                 RunEvent[]
  runs                      Run[]
  uploadedDocuments         UploadedDocument[]
  users                     User[]
  workspaces                Workspace[]
  tenantActionPolicies      TenantActionPolicy[]
  guardrailAuditLedger      GuardrailAuditLedger[]
  sclLedger                 SclLedger[]
  toolContracts             ToolContract[]
  marketplaceItems          MarketplaceItem[]
  delegationsAsOwner        DelegationPolicy[]          @relation("DelegatorTenant")
  delegationsAsGuest        DelegationPolicy[]          @relation("DelegateeTenant")
  agentTrustScores          AgentTrustScore[]
  billingAccount            TenantBillingAccount?
  quotaPolicy               TenantQuotaPolicy?
  quotaUsages               TenantQuotaUsage[]
  workspaceQuotaUsages      WorkspaceQuotaUsage[]
  workspaceQuotaGrants      WorkspaceQuotaGrant[]
  workspaceAgentAssignments WorkspaceAgentAssignment[]
  runUsageBreakdowns        RunUsageBreakdown[]
  billingLedgerEntries      BillingLedger[]
  invoices                  TenantInvoice[]
  helpdeskSessions          HelpdeskSession[]
  productInstallations      TenantProductInstallation[]
  runArchives               RunArchive[]
  imobOwners                ImobOwner[]
  imobProperties            ImobProperty[]
  imobLeads                 ImobLead[]
  imobCases                 ImobCase[]
  imobCaseEvents            ImobCaseEvent[]
  imobMarketScanRuns        ImobMarketScanRun[]
  agentInstalls             AgentInstall[]
  connectorInstances        ConnectorInstance[]
  paymentIntents            PaymentIntent[]
  memberships               TenantMembership[]
  customRoles               TenantCustomRole[]
  walletIdentities          WalletIdentity[]

  @@map("tenants")
}

model Workspace {
  id                        String                      @id @default(cuid())
  tenantId                  String                      @map("tenant_id")
  name                      String
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")
  apiTokens                 ApiToken[]
  embeddingChunks           EmbeddingChunk[]
  memoryEvents              MemoryEvent[]
  memorySnapshots           MemorySnapshot[]
  runEvents                 RunEvent[]
  runs                      Run[]
  uploadedDocuments         UploadedDocument[]
  tenant                    Tenant                      @relation(fields: [tenantId], references: [id])
  tenantActionPolicies      TenantActionPolicy[]
  guardrailAuditLedger      GuardrailAuditLedger[]
  sclLedger                 SclLedger[]
  agentTrustScores          AgentTrustScore[]
  workspaceQuotaUsages      WorkspaceQuotaUsage[]
  workspaceQuotaGrants      WorkspaceQuotaGrant[]
  workspaceAgentAssignments WorkspaceAgentAssignment[]
  runUsageBreakdowns        RunUsageBreakdown[]
  billingLedgerEntries      BillingLedger[]
  helpdeskSessions          HelpdeskSession[]
  productInstallations      TenantProductInstallation[]
  runArchives               RunArchive[]
  imobOwners                ImobOwner[]
  imobProperties            ImobProperty[]
  imobLeads                 ImobLead[]
  imobCases                 ImobCase[]
  imobCaseEvents            ImobCaseEvent[]
  imobMarketScanRuns        ImobMarketScanRun[]
  agentInstalls             AgentInstall[]
  connectorInstances        ConnectorInstance[]
  paymentIntents            PaymentIntent[]

  @@index([tenantId, name])
  @@map("workspaces")
}

model User {
  id                              String                      @id @default(cuid())
  tenantId                        String                      @map("tenant_id")
  email                           String                      @unique
  displayName                     String?                     @map("display_name")
  createdAt                       DateTime                    @default(now()) @map("created_at")
  updatedAt                       DateTime                    @updatedAt @map("updated_at")
  apiTokens                       ApiToken[]
  runEvents                       RunEvent[]
  runs                            Run[]
  workspaceAgentAssignmentsSigned WorkspaceAgentAssignment[]  @relation("WorkspaceAgentAssignmentSignedBy")
  tenant                          Tenant                      @relation(fields: [tenantId], references: [id])
  productInstallationsActivated   TenantProductInstallation[] @relation("ProductInstallationActivatedBy")
  agentInstalls                   AgentInstall[]
  connectorInstances              ConnectorInstance[]
  memberships                     TenantMembership[]
  walletIdentities                WalletIdentity[]

  @@index([tenantId, email])
  @@map("users")
}

model TenantProductInstallation {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  workspaceId       String   @map("workspace_id")
  product           String
  status            String   @default("active")
  activatedAt       DateTime @default(now()) @map("activated_at")
  activatedByUserId String?  @map("activated_by_user_id")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  activatedByUser User?     @relation("ProductInstallationActivatedBy", fields: [activatedByUserId], references: [id])

  @@unique([tenantId, workspaceId, product], name: "tenant_workspace_product_unique", map: "tenant_product_installations_tenant_workspace_product_key")
  @@index([tenantId, status], map: "tenant_product_installations_tenant_status_idx")
  @@index([workspaceId, product, status], map: "tenant_product_installations_workspace_product_status_idx")
  @@map("tenant_product_installations")
}

model ApiToken {
  id          String    @id @default(cuid())
  token       String    @unique
  tenantId    String    @map("tenant_id")
  workspaceId String    @map("workspace_id")
  userId      String?   @map("user_id")
  description String?
  expiresAt   DateTime? @map("expires_at")
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, workspaceId])
  @@index([userId])
  @@map("api_tokens")
}

model Run {
  id             String            @id @default(cuid())
  tenantId       String            @map("tenant_id")
  workspaceId    String            @map("workspace_id")
  userId         String?           @map("user_id")
  caseId         String?           @map("case_id")
  threadId       String?           @map("thread_id")
  agent          String
  agentVersion   String?           @map("agent_version")
  assignmentId   String?           @map("assignment_id")
  status         RunStatus
  request        Json
  response       Json?
  costCents      Int               @default(0)
  traceId        String?
  startedAt      DateTime          @default(now())
  finishedAt     DateTime?
  errorCode      String?
  approvalStatus RunApprovalStatus @default(not_required) @map("approval_status")
  approvedBy     String?           @map("approved_by")
  approvedAt     DateTime?         @map("approved_at")
  archivedAt     DateTime?         @map("archived_at")
  archiveRef     String?           @unique @map("archive_ref")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // ⚙️ Adições necessárias para reconciliar Ledger e Runs
  criticalHash String? @map("critical_hash")
  sclTxId      String? @map("scl_tx_id")
  txId         String? @map("tx_id")

  // 🔗 Relações
  memoryEvents         MemoryEvent[]
  events               RunEvent[]
  guardrailLedgers     GuardrailLedger[]
  billingLedgerEntries BillingLedger[]
  usageBreakdowns      RunUsageBreakdown[]
  imobCaseEvents       ImobCaseEvent[]
  runArchive           RunArchive?
  paymentIntents       PaymentIntent[]
  assignment           WorkspaceAgentAssignment? @relation(fields: [assignmentId], references: [id])
  tenant               Tenant                    @relation(fields: [tenantId], references: [id])
  user                 User?                     @relation(fields: [userId], references: [id])
  workspace            Workspace                 @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, workspaceId, agent, createdAt])
  @@index([assignmentId])
  @@index([caseId])
  @@index([threadId])
  @@index([status])
  @@index([costCents])
  @@index([archivedAt])
  @@map("runs")
}

model RunArchive {
  id          String   @id @default(cuid())
  runId       String   @unique @map("run_id")
  tenantId    String   @map("tenant_id")
  workspaceId String   @map("workspace_id")
  archiveRef  String   @unique @map("archive_ref")
  archivedAt  DateTime @map("archived_at")
  snapshot    Json
  createdAt   DateTime @default(now()) @map("created_at")

  run       Run       @relation(fields: [runId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, workspaceId, archivedAt], map: "run_archives_tenant_workspace_archived_at_idx")
  @@map("run_archives")
}

model RunEvent {
  id           String    @id @default(cuid())
  runId        String    @map("run_id")
  tenantId     String    @map("tenant_id")
  workspaceId  String    @map("workspace_id")
  userId       String?   @map("user_id")
  type         String
  payload      Json?
  criticalHash String?   @map("critical_hash")
  sclTxId      String?   @map("scl_tx_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  run          Run       @relation(fields: [runId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  user         User?     @relation(fields: [userId], references: [id])
  workspace    Workspace @relation(fields: [workspaceId], references: [id])

  @@index([runId, createdAt])
  @@index([tenantId, workspaceId, createdAt])
  @@map("run_events")
}

model PlanStepRecord {
  id          String   @id @default(cuid())
  runId       String
  tenantId    String
  workspaceId String
  stepIndex   Int
  stepType    String
  input       Json?
  output      Json?
  createdAt   DateTime @default(now())

  @@index([runId])
}

model PlanQuota {
  projectId       String   @id
  softLimitCents  Int
  hardLimitCents  Int
  monthUsageCents Int      @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("plan_quotas")
}

model Pricing {
  id          String   @id @default(cuid())
  agent       String
  perRunCents Int      @default(0)
  perMBcents  Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  // 🔹 Relação inversa com AgentMetadata
  agentMetadata AgentMetadata? @relation("AgentPricing")

  @@index([agent, active])
  @@map("pricing")
}

model AgentProfile {
  id           String   @id @default(cuid())
  agent        String   @unique
  name         String
  description  String?
  model        String
  systemPrompt String
  tools        Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("agent_profiles")
}

model PaymentTx {
  id          String        @id @default(cuid())
  projectId   String
  provider    String
  externalId  String
  amountCents Int
  status      PaymentStatus
  createdAt   DateTime      @default(now())

  @@index([projectId, createdAt])
  @@map("payment_tx")
}

model UploadedDocument {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  workspaceId String    @map("workspace_id")
  agentSlug   String    @map("agent_slug")
  fileName    String    @map("file_name")
  mimeType    String    @map("mime_type")
  sizeBytes   Int       @map("size_bytes")
  storageKey  String    @map("storage_key")
  url         String
  createdAt   DateTime  @default(now()) @map("created_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, workspaceId, agentSlug])
  @@map("uploaded_documents")
}

model AgentRecommendationState {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  workspaceId String   @map("workspace_id")
  agent       String
  state       Json
  lastRunId   String?  @map("last_run_id")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, workspaceId, agent])
  @@index([agent])
  @@map("agent_recommendation_state")
}

model MemorySnapshot {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  workspaceId String    @map("workspace_id")
  agentId     String    @map("agent_id")
  shortTerm   Json      @map("short_term")
  longTerm    Json      @map("long_term")
  vectorState Json?     @map("vector_state")
  cursor      String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([tenantId, workspaceId, agentId])
  @@map("memory_snapshots")
}

model MemoryEvent {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  workspaceId String    @map("workspace_id")
  agentId     String    @map("agent_id")
  runId       String?   @map("run_id")
  key         String
  content     String
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  run         Run?      @relation(fields: [runId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, workspaceId, agentId, createdAt])
  @@map("memory_events")
}

model EmbeddingChunk {
  id          String                      @id @default(cuid())
  tenantId    String                      @map("tenant_id")
  workspaceId String                      @map("workspace_id")
  agentId     String                      @map("agent_id")
  chunkKey    String                      @map("chunk_key")
  embedding   Unsupported("vector(1536)")
  metadata    Json?
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")
  tenant      Tenant                      @relation(fields: [tenantId], references: [id])
  workspace   Workspace                   @relation(fields: [workspaceId], references: [id])

  @@unique([tenantId, workspaceId, agentId, chunkKey])
  @@index([tenantId, workspaceId, agentId])
  @@map("embedding_chunks")
}

model ActionVersion {
  id          String   @id @default(cuid())
  name        String
  version     String
  description String?
  schema      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([name, version], name: "unique_name_version")
  @@map("action_versions")
}

model ActionRegistry {
  id          String   @id @default(cuid())
  name        String
  version     Int      @default(1)
  description String?
  schema      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([name, version])
  @@map("action_registry")
}

// ================================
// 🧩 Fase 2.5 — MCP Runner + Tool Contracting
// Contratos formais de execução para cada Tool/Action
// ================================

model ToolContract {
  id           String   @id @default(cuid())
  name         String
  version      String
  tenantId     String   @map("tenant_id")
  inputSchema  Json
  outputSchema Json?
  executor     String
  trustLevel   Int
  policyId     String?
  limits       Json?
  metadata     Json?
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")

  // 🔗 Relações
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name, version], map: "tool_contracts_tenant_id_name_version_key")
  @@map("tool_contracts")
}

model TenantActionPolicy {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  workspaceId String?  @map("workspace_id")
  actionName  String   @map("action_name")
  allowed     Boolean  @default(true)
  maxVersion  Int?     @map("max_version")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, actionName])
  @@map("tenant_action_policy")
}

// ================================
// 🧠 Fase 4 — DLT Compliance Gate
// Ledger e Auditoria (corrigido para evitar loops)
// ================================

model GuardrailAuditLedger {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  workspaceId String?  @map("workspace_id")
  runId       String?  @map("run_id")
  eventType   String   @map("event_type")
  severity    String   @default("info")
  message     String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, eventType])
  @@map("guardrail_audit_ledger")
}

model SclLedger {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  workspaceId    String?   @map("workspace_id")
  runId          String    @map("run_id")
  criticalHash   String    @map("critical_hash")
  txId           String    @unique @map("tx_id")
  payload        Json?
  signature      String?   @map("signature")
  signatureAlg   String?   @map("signature_alg")
  signatureKeyId String?   @map("signature_key_id")
  signatureNonce String?   @map("signature_nonce")
  tenantHash     String?   @map("tenant_hash")
  signedAt       DateTime? @map("signed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, createdAt])
  @@index([runId])
  @@map("scl_ledger")
}

model GuardrailLedger {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  runId          String?   @map("run_id")
  actionType     String    @map("action_type")
  criticalHash   String    @map("critical_hash")
  payloadHash    String?   @map("payload_hash")
  riskScore      Float?    @map("risk_score")
  trustScore     Float?    @map("trust_score")
  txId           String?   @map("tx_id")
  signature      String?   @map("signature")
  signatureKeyId String?   @map("signature_key_id")
  signedAt       DateTime? @map("signed_at")
  timestamp      DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  run    Run?   @relation(fields: [runId], references: [id])

  @@index([tenantId, txId])
  @@index([tenantId, criticalHash])
  @@map("guardrail_ledger")
}

model MarketplaceItem {
  id          String   @id @default(cuid())
  type        String
  name        String
  version     String
  description String?
  publisherId String   @map("publisher_id")
  trustScore  Float?   @map("trust_score")
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")

  publisher   Tenant             @relation(fields: [publisherId], references: [id])
  delegations DelegationPolicy[]

  @@index([publisherId, type, name, version])
  @@map("marketplace_items")
}

model DelegationPolicy {
  id            String   @id @default(cuid())
  delegatorId   String   @map("delegator_id")
  delegateeId   String   @map("delegatee_id")
  marketplaceId String?  @map("marketplace_id")
  scope         String
  trustMin      Float    @map("trust_min")
  validUntil    DateTime @map("valid_until")
  policyHash    String   @map("policy_hash")
  signatureHash String   @map("signature_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  delegator   Tenant           @relation("DelegatorTenant", fields: [delegatorId], references: [id])
  delegatee   Tenant           @relation("DelegateeTenant", fields: [delegateeId], references: [id])
  marketplace MarketplaceItem? @relation(fields: [marketplaceId], references: [id])

  @@index([delegatorId, delegateeId, scope])
  @@index([marketplaceId])
  @@map("delegation_policies")
}

model AgentMetadata {
  id            String   @id @default(cuid())
  agent         String   @unique
  displayName   String
  description   String?
  category      String?
  version       String   @default("1.0.0")
  trustBaseline Float    @default(0.85)
  sclCritical   Boolean  @default(false)
  pricingId     String?  @unique
  pricing       Pricing? @relation("AgentPricing", fields: [pricingId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ================================
// 🤖 Fase 3.5 — Governança Cognitiva Persistente
// Persistência de confiança por agente
// ================================

model AgentTrustScore {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  workspaceId  String?  @map("workspace_id")
  agentId      String   @map("agent_id")
  currentScore Int      @default(100) // Score ativo (0–200)
  baseline     Int      @default(100) // Valor inicial ou de referência
  lastDelta    Int      @default(0) // Última variação aplicada
  trend        String   @default("stable") // stable | rising | falling
  lastUpdated  DateTime @updatedAt @map("last_updated")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@unique([tenantId, workspaceId, agentId], name: "unique_trustscore_agent")
  @@index([tenantId, agentId, lastUpdated])
  @@map("agent_trust_scores")
}

model TenantBillingAccount {
  id             String   @id @default(cuid())
  tenantId       String   @unique @map("tenant_id")
  planCode       String   @default("starter") @map("plan_code")
  currency       String   @default("BRL")
  status         String   @default("active")
  cycleAnchorDay Int      @default(1) @map("cycle_anchor_day")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("tenant_billing_account")
}

model TenantQuotaPolicy {
  id                    String   @id @default(cuid())
  tenantId              String   @unique @map("tenant_id")
  softLimitPct          Int      @default(80) @map("soft_limit_pct")
  hardLimitPct          Int      @default(100) @map("hard_limit_pct")
  monthlyRunsLimit      Int?     @map("monthly_runs_limit")
  monthlyCostCentsLimit Int?     @map("monthly_cost_cents_limit")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_quota_policy")
}

model TenantQuotaUsage {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  cycleStart DateTime @map("cycle_start")
  cycleEnd   DateTime @map("cycle_end")
  runs       Int      @default(0)
  costCents  Int      @default(0) @map("cost_cents")
  tokens     Int      @default(0)
  storageMb  Int      @default(0) @map("storage_mb")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, cycleStart, cycleEnd], name: "tenant_quota_usage_cycle_unique", map: "tenant_quota_usage_cycle_unique")
  @@index([tenantId, cycleStart, cycleEnd], map: "tenant_quota_usage_tenant_cycle_idx")
  @@map("tenant_quota_usage")
}

