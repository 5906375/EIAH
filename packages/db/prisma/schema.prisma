generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  engineType    = "binary"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// 🧠 Enums — Execução e Pagamentos
// (necessários para validação e índices)
// ========================================

enum RunStatus {
  pending
  awaiting_approval
  running
  success
  error
  blocked
}

enum RunMode {
  LIVE
  DRY_RUN
}

enum PaymentStatus {
  pending
  succeeded
  failed
}

enum DelegationStatus {
  pending_approval
  active
  rejected
  revoked
}

enum TenantRole {
  TENANT_ADMIN
  TENANT_OPERATOR
  TENANT_VIEWER
}

enum MembershipStatus {
  INVITED
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  DISABLED
}

enum LifecycleStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum WorkspaceStatus {
  ACTIVE
  DISABLED
}

model Tenant {
  id                   String                 @id @default(cuid())
  name                 String
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  apiTokens            ApiToken[]
  customRoles          TenantRoleCustom[]
  embeddingChunks      EmbeddingChunk[]
  guardrailLedger      GuardrailLedger[]
  memoryEvents         MemoryEvent[]
  memorySnapshots      MemorySnapshot[]
  runEvents            RunEvent[]
  runs                 Run[]
  uploadedDocuments    UploadedDocument[]
  users                User[]
  workspaces           Workspace[]
  tenantActionPolicies TenantActionPolicy[]
  guardrailAuditLedger GuardrailAuditLedger[]
  sclLedger            SclLedger[]
  toolContracts        ToolContract[]
  marketplaceItems     MarketplaceItem[]
  delegationsAsOwner   DelegationPolicy[]     @relation("DelegatorTenant")
  delegationsAsGuest   DelegationPolicy[]     @relation("DelegateeTenant")
  agentTrustScores     AgentTrustScore[]
  memberships          TenantMembership[]
  connectorInstances   ConnectorInstance[]
  agentInstalls        AgentInstall[]
  tenantEntitlements   TenantEntitlement[]
  workspaceEntitlements WorkspaceEntitlement[]
  proofOfUsage         ProofOfUsage[]
  approvalRecords      ApprovalRecord[]
  walletIdentities     WalletIdentity[]

  @@map("tenants")
}

model Workspace {
  id                   String                 @id @default(cuid())
  tenantId             String                 @map("tenant_id")
  name                 String
  status               WorkspaceStatus        @default(ACTIVE)
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  apiTokens            ApiToken[]
  embeddingChunks      EmbeddingChunk[]
  memoryEvents         MemoryEvent[]
  memorySnapshots      MemorySnapshot[]
  runEvents            RunEvent[]
  runs                 Run[]
  uploadedDocuments    UploadedDocument[]
  tenant               Tenant                 @relation(fields: [tenantId], references: [id])
  tenantActionPolicies TenantActionPolicy[]
  guardrailAuditLedger GuardrailAuditLedger[]
  sclLedger            SclLedger[]
  agentTrustScores     AgentTrustScore[]
  connectorInstances   ConnectorInstance[]
  agentInstalls        AgentInstall[]
  workspaceEntitlements WorkspaceEntitlement[]
  proofOfUsage         ProofOfUsage[]
  walletIdentities     WalletIdentity[]

  @@index([tenantId, name])
  @@map("workspaces")
}

model User {
  id          String     @id @default(cuid())
  tenantId    String     @map("tenant_id")
  email       String     @unique
  displayName String?    @map("display_name")
  passwordHash String?   @map("password_hash")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  apiTokens   ApiToken[]
  runEvents   RunEvent[]
  runs        Run[]
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  memberships TenantMembership[]
  profiles    UserProfile[]
  connectorInstances ConnectorInstance[] @relation("ConnectorCreatedBy")
  agentInstalls       AgentInstall[]     @relation("AgentInstalledBy")
  workspaceEntitlementsActivated WorkspaceEntitlement[] @relation("WorkspaceEntitlementActivatedBy")
  walletIdentities    WalletIdentity[]

  @@index([tenantId, email])
  @@map("users")
}

model UserProfile {
  id          String   @id @default(cuid())
  groupId     String   @map("group_id")
  userId      String?  @map("user_id")
  fullName    String?  @map("full_name")
  email       String?
  phone       String?
  cep         String?
  company     String?
  role        String?
  website     String?
  city        String?
  country     String?
  tenantId    String?  @map("tenant_id")
  workspaceId String?  @map("workspace_id")
  token       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id])
  walletIdentities WalletIdentity[]

  @@index([groupId])
  @@index([userId])
  @@map("user_profiles")
}

model WalletIdentity {
  id          String   @id @default(cuid())
  address     String   @unique
  chainId     Int?     @map("chain_id")
  userId      String   @map("user_id")
  profileId   String?  @map("profile_id")
  tenantId    String   @map("tenant_id")
  workspaceId String?  @map("workspace_id")
  lastSeenAt  DateTime? @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User        @relation(fields: [userId], references: [id])
  profile   UserProfile? @relation(fields: [profileId], references: [id])
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  workspace Workspace?  @relation(fields: [workspaceId], references: [id])

  @@index([userId])
  @@index([tenantId, workspaceId])
  @@map("wallet_identities")
}

model SiweNonce {
  id        String   @id @default(cuid())
  address   String
  nonce     String   @unique
  expiresAt DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([address])
  @@index([expiresAt])
  @@map("siwe_nonces")
}

model TenantMembership {
  id        String           @id @default(cuid())
  tenantId  String           @map("tenant_id")
  userId    String           @map("user_id")
  role      TenantRole       @default(TENANT_OPERATOR)
  status    MembershipStatus @default(ACTIVE)
  customRoleId String?       @map("custom_role_id")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  customRole TenantRoleCustom? @relation(fields: [customRoleId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([customRoleId])
  @@map("tenant_memberships")
}

model TenantRoleCustom {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  name        String
  description String?          @map("description")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  memberships TenantMembership[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tenant_role_customs")
}

model RolePermission {
  id            String           @id @default(cuid())
  roleId        String           @map("role_id")
  permissionKey String           @map("permission_key")
  createdAt     DateTime         @default(now()) @map("created_at")

  role TenantRoleCustom @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([roleId])
  @@map("role_permissions")
}

model ConnectorInstance {
  id               String          @id @default(cuid())
  tenantId         String          @map("tenant_id")
  workspaceId      String          @map("workspace_id")
  provider         String
  allowedResources Json            @map("allowed_resources")
  limits           Json            @map("limits")
  vaultSecretRef   String          @map("vault_secret_ref")
  status           LifecycleStatus @default(DRAFT)
  createdByUserId  String?         @map("created_by_user_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  createdBy User?     @relation("ConnectorCreatedBy", fields: [createdByUserId], references: [id])

  @@index([tenantId])
  @@index([workspaceId])
  @@map("connector_instances")
}

model AgentInstall {
  id               String          @id @default(cuid())
  tenantId         String          @map("tenant_id")
  workspaceId      String          @map("workspace_id")
  agentId          String          @map("agent_id")
  version          String
  config           Json            @map("config")
  status           LifecycleStatus @default(DRAFT)
  installedByUserId String?        @map("installed_by_user_id")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  installedBy User?     @relation("AgentInstalledBy", fields: [installedByUserId], references: [id])

  @@index([tenantId])
  @@index([workspaceId])
  @@index([agentId])
  @@unique([tenantId, workspaceId, agentId], name: "unique_agent_install_workspace")
  @@map("agent_installs")
}

model TenantEntitlement {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  agentId     String          @map("agent_id")
  marketplaceId String?       @map("marketplace_id")
  planRef     String?         @map("plan_ref")
  quotaRef    String?         @map("quota_ref")
  status      LifecycleStatus @default(ACTIVE)
  startsAt    DateTime?       @map("starts_at")
  endsAt      DateTime?       @map("ends_at")
  metadata    Json?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant                Tenant                  @relation(fields: [tenantId], references: [id])
  marketplace           MarketplaceItem?        @relation(fields: [marketplaceId], references: [id])
  workspaceEntitlements WorkspaceEntitlement[]

  @@unique([tenantId, agentId], name: "unique_tenant_entitlement_agent")
  @@index([tenantId, status])
  @@index([marketplaceId])
  @@map("tenant_entitlements")
}

model WorkspaceEntitlement {
  id                  String          @id @default(cuid())
  tenantId            String          @map("tenant_id")
  workspaceId         String          @map("workspace_id")
  agentId             String          @map("agent_id")
  tenantEntitlementId String?         @map("tenant_entitlement_id")
  status              LifecycleStatus @default(ACTIVE)
  activatedByUserId   String?         @map("activated_by_user_id")
  metadata            Json?
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  workspace         Workspace          @relation(fields: [workspaceId], references: [id])
  tenantEntitlement TenantEntitlement? @relation(fields: [tenantEntitlementId], references: [id])
  activatedBy       User?              @relation("WorkspaceEntitlementActivatedBy", fields: [activatedByUserId], references: [id])

  @@unique([tenantId, workspaceId, agentId], name: "unique_workspace_entitlement_agent")
  @@index([tenantId, status])
  @@index([workspaceId, status])
  @@index([tenantEntitlementId])
  @@map("workspace_entitlements")
}

model ApiToken {
  id          String    @id @default(cuid())
  token       String    @unique
  tenantId    String    @map("tenant_id")
  workspaceId String    @map("workspace_id")
  userId      String?   @map("user_id")
  description String?
  expiresAt   DateTime? @map("expires_at")
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, workspaceId])
  @@index([userId])
  @@map("api_tokens")
}

model Run {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  workspaceId String    @map("workspace_id")
  userId      String?   @map("user_id")
  agent       String
  status      RunStatus
  runMode     RunMode   @default(LIVE) @map("run_mode")
  request     Json
  response    Json?
  estimatedCostCents Int? @map("estimated_cost_cents")
  finalCostCents Int? @map("final_cost_cents")
  costCents   Int       @default(0)
  charged     Boolean?
  chargeReason String? @map("charge_reason")
  chargeAttemptedAt DateTime? @map("charge_attempted_at")
  traceId     String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  errorCode   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ⚙️ Adições necessárias para reconciliar Ledger e Runs
  criticalHash String? @map("critical_hash")
  sclTxId      String? @map("scl_tx_id")
  txId         String? @map("tx_id")

  // 🔗 Relações
  memoryEvents     MemoryEvent[]
  events           RunEvent[]
  guardrailLedgers GuardrailLedger[]
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  user             User?             @relation(fields: [userId], references: [id])
  workspace        Workspace         @relation(fields: [workspaceId], references: [id])
  proofOfUsage      ProofOfUsage[]
  approvalRecords   ApprovalRecord[]

  @@index([tenantId, workspaceId, agent, createdAt])
  @@index([status])
  @@index([costCents])
  @@map("runs")
}

model RunEvent {
  id           String    @id @default(cuid())
  runId        String    @map("run_id")
  tenantId     String    @map("tenant_id")
  workspaceId  String    @map("workspace_id")
  userId       String?   @map("user_id")
  type         String
  payload      Json?
  criticalHash String?   @map("critical_hash")
  sclTxId      String?   @map("scl_tx_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  run          Run       @relation(fields: [runId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  user         User?     @relation(fields: [userId], references: [id])
  workspace    Workspace @relation(fields: [workspaceId], references: [id])

  @@index([runId, createdAt])
  @@index([tenantId, workspaceId, createdAt])
  @@map("run_events")
}

model PlanStepRecord {
  id          String   @id @default(cuid())
  runId       String
  tenantId    String
  workspaceId String
  stepIndex   Int
  stepType    String
  input       Json?
  output      Json?
  createdAt   DateTime @default(now())

  @@index([runId])
}

model PlanQuota {
  projectId       String   @id
  softLimitCents  Int
  hardLimitCents  Int
  monthUsageCents Int      @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("plan_quotas")
}

model Pricing {
  id          String   @id @default(cuid())
  agent       String
  perRunCents Int      @default(0)
  perMBcents  Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  // 🔹 Relação inversa com AgentMetadata
  agentMetadata AgentMetadata? @relation("AgentPricing")

  @@index([agent, active])
  @@map("pricing")
}

model AgentProfile {
  id           String   @id @default(cuid())
  agent        String   @unique
  name         String
  description  String?
  model        String
  systemPrompt String
  tools        Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("agent_profiles")
}

model PaymentTx {
  id          String        @id @default(cuid())
  projectId   String
  provider    String
  externalId  String
  amountCents Int
  status      PaymentStatus
  createdAt   DateTime      @default(now())

  @@index([projectId, createdAt])
  @@map("payment_tx")
}

model UploadedDocument {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  workspaceId String    @map("workspace_id")
  agentSlug   String    @map("agent_slug")
  fileName    String    @map("file_name")
  mimeType    String    @map("mime_type")
  sizeBytes   Int       @map("size_bytes")
  storageKey  String    @map("storage_key")
  url         String
  createdAt   DateTime  @default(now()) @map("created_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, workspaceId, agentSlug])
  @@map("uploaded_documents")
}

model AgentRecommendationState {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  workspaceId String   @map("workspace_id")
  agent       String
  state       Json
  lastRunId   String?  @map("last_run_id")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, workspaceId, agent])
  @@index([agent])
  @@map("agent_recommendation_state")
}

model MemorySnapshot {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  workspaceId String    @map("workspace_id")
  agentId     String    @map("agent_id")
  shortTerm   Json      @map("short_term")
  longTerm    Json      @map("long_term")
  vectorState Json?     @map("vector_state")
  cursor      String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([tenantId, workspaceId, agentId])
  @@map("memory_snapshots")
}

model MemoryEvent {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  workspaceId String    @map("workspace_id")
  agentId     String    @map("agent_id")
  runId       String?   @map("run_id")
  key         String
  content     String
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  run         Run?      @relation(fields: [runId], references: [id])
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, workspaceId, agentId, createdAt])
  @@map("memory_events")
}

model EmbeddingChunk {
  id          String                      @id @default(cuid())
  tenantId    String                      @map("tenant_id")
  workspaceId String                      @map("workspace_id")
  agentId     String                      @map("agent_id")
  chunkKey    String                      @map("chunk_key")
  embedding   Unsupported("vector(1536)")
  metadata    Json?
  createdAt   DateTime                    @default(now()) @map("created_at")
  updatedAt   DateTime                    @updatedAt @map("updated_at")
  tenant      Tenant                      @relation(fields: [tenantId], references: [id])
  workspace   Workspace                   @relation(fields: [workspaceId], references: [id])

  @@unique([tenantId, workspaceId, agentId, chunkKey])
  @@index([tenantId, workspaceId, agentId])
  @@map("embedding_chunks")
}

model ActionVersion {
  id          String   @id @default(cuid())
  name        String
  version     String
  description String?
  schema      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([name, version], name: "unique_name_version")
  @@map("action_versions")
}

model ActionRegistry {
  id          String   @id @default(cuid())
  name        String
  version     Int      @default(1)
  description String?
  schema      Json?
  criticality        String   @default("unknown")
  criticalitySource  String   @default("default") @map("criticality_source")
  needsReview        Boolean  @default(true) @map("needs_review")
  sideEffects        Boolean? @map("side_effects")
  dataSensitivity    String?  @map("data_sensitivity")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([name, version])
  @@map("action_registry")
}

// ================================
// 🧩 Fase 2.5 — MCP Runner + Tool Contracting
// Contratos formais de execução para cada Tool/Action
// ================================

model ToolContract {
  id           String   @id @default(cuid())
  name         String
  version      String
  tenantId     String   @map("tenant_id")
  inputSchema  Json
  outputSchema Json?
  executor     String
  trustLevel   Int
  policyId     String?
  limits       Json?
  metadata     Json?
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")

  // 🔗 Relações
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, name, version])
  @@map("tool_contracts")
}

model TenantActionPolicy {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  workspaceId String?  @map("workspace_id")
  actionName  String   @map("action_name")
  allowed     Boolean  @default(true)
  maxVersion  Int?     @map("max_version")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, actionName])
  @@map("tenant_action_policy")
}

// ================================
// 🧠 Fase 4 — DLT Compliance Gate
// Ledger e Auditoria (corrigido para evitar loops)
// ================================

model GuardrailAuditLedger {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  workspaceId String?  @map("workspace_id")
  runId       String?  @map("run_id")
  eventType   String   @map("event_type")
  severity    String   @default("info")
  message     String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, eventType])
  @@map("guardrail_audit_ledger")
}

model SclLedger {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  workspaceId    String?   @map("workspace_id")
  runId          String    @map("run_id")
  criticalHash   String    @map("critical_hash")
  txId           String    @unique @map("tx_id")
  payload        Json?
  signature      String?   @map("signature")
  signatureAlg   String?   @map("signature_alg")
  signatureKeyId String?   @map("signature_key_id")
  signatureNonce String?   @map("signature_nonce")
  tenantHash     String?   @map("tenant_hash")
  signedAt       DateTime? @map("signed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([tenantId, createdAt])
  @@index([runId])
  @@map("scl_ledger")
}

model GuardrailLedger {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  runId          String?   @map("run_id")
  actionType     String    @map("action_type")
  criticalHash   String    @map("critical_hash")
  payloadHash    String?   @map("payload_hash")
  riskScore      Float?    @map("risk_score")
  trustScore     Float?    @map("trust_score")
  txId           String?   @map("tx_id")
  signature      String?   @map("signature")
  signatureKeyId String?   @map("signature_key_id")
  signedAt       DateTime? @map("signed_at")
  timestamp      DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  run    Run?   @relation(fields: [runId], references: [id])

  @@index([tenantId, txId])
  @@index([tenantId, criticalHash])
  @@map("guardrail_ledger")
}

enum PoUStatus {
  PENDING
  FINALIZED
  FAILED
  PENDING_TRUST
}

enum PoUFailureReason {
  DB_WRITE_FAILED
  VALIDATION_ERROR
  SIGNER_ERROR
  OUTPUT_UNAVAILABLE
  HASH_ERROR
  ATTESTATION_FAILED
  UNKNOWN
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

model ProofOfUsage {
  id                 String          @id @default(cuid())
  tenantId           String          @map("tenant_id")
  workspaceId        String?         @map("workspace_id")
  runId              String          @map("run_id")
  actionId           String          @map("action_id")
  intentHash         String          @map("intent_hash")
  paramsHash         String          @map("params_hash")
  signatureHash      String          @map("signature_hash")
  resultHash         String          @map("result_hash")
  trustSnapshot      Json?           @map("trust_snapshot")
  compositeTxId      String          @unique @map("composite_tx_id")
  canonicalResultRef String?         @map("canonical_result_ref")
  status             PoUStatus       @default(PENDING)
  attestationKeyId   String?         @map("attestation_key_id")
  attestationSignature String?       @map("attestation_signature")
  failureReason      PoUFailureReason? @map("failure_reason")
  createdAt          DateTime        @default(now()) @map("created_at")
  finalizedAt        DateTime?       @map("finalized_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  run       Run        @relation(fields: [runId], references: [id])

  @@unique([runId, actionId])
  @@index([tenantId, workspaceId])
  @@index([compositeTxId])
  @@map("proof_of_usage")
}

model ApprovalRecord {
  id              String           @id @default(cuid())
  runId           String           @map("run_id")
  attempt         Int
  tenantId        String           @map("tenant_id")
  approverId      String           @map("approver_id")
  decision        ApprovalDecision
  reason          String?
  policyId        String?          @map("policy_id")
  policyVersion   String           @map("policy_version")
  requiredMinTrust Float?          @map("required_min_trust")
  approverTrust   Float            @map("approver_trust")
  intentHash      String           @map("intent_hash")
  planHash        String           @map("plan_hash")
  idempotencyKey  String?          @map("idempotency_key")
  payloadHash     String           @map("payload_hash")
  sclSignature    String?          @map("scl_signature")
  createdAt       DateTime         @default(now()) @map("created_at")

  run    Run    @relation(fields: [runId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([runId, attempt])
  @@unique([runId, idempotencyKey])
  @@index([tenantId, runId])
  @@map("approval_records")
}

model RunExecutionLock {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  workspaceId String   @map("workspace_id")
  runId       String   @map("run_id")
  holderId    String   @map("holder_id")
  attempt     Int      @default(1)
  acquiredAt  DateTime @default(now()) @map("acquired_at")
  expiresAt   DateTime @map("expires_at")

  @@unique([tenantId, workspaceId, runId], name: "uniq_run_execution_lock")
  @@index([tenantId, workspaceId])
  @@map("run_execution_locks")
}

model MarketplaceItem {
  id          String   @id @default(cuid())
  type        String
  name        String
  version     String
  description String?
  publisherId String   @map("publisher_id")
  trustScore  Float?   @map("trust_score")
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")

  publisher   Tenant             @relation(fields: [publisherId], references: [id])
  delegations DelegationPolicy[]
  tenantEntitlements TenantEntitlement[]

  @@index([publisherId, type, name, version])
  @@map("marketplace_items")
}

model DelegationPolicy {
  id                    String           @id @default(cuid())
  delegatorId           String           @map("delegator_id")
  delegateeId           String           @map("delegatee_id")
  marketplaceId         String?          @map("marketplace_id")
  scope                 String
  trustMin              Float            @map("trust_min")
  validUntil            DateTime         @map("valid_until")
  policyHash            String           @map("policy_hash")
  signatureHash         String           @map("signature_hash")
  createdAt             DateTime         @default(now()) @map("created_at")
  status                DelegationStatus @default(pending_approval)
  providerSignatureHash String?          @map("provider_signature_hash")
  decidedAt             DateTime?        @map("decided_at")

  delegator   Tenant           @relation("DelegatorTenant", fields: [delegatorId], references: [id])
  delegatee   Tenant           @relation("DelegateeTenant", fields: [delegateeId], references: [id])
  marketplace MarketplaceItem? @relation(fields: [marketplaceId], references: [id])

  @@index([delegatorId, delegateeId, scope])
  @@index([marketplaceId])
  @@map("delegation_policies")
}

model AgentMetadata {
  id            String   @id @default(cuid())
  agent         String   @unique
  displayName   String
  description   String?
  category      String?
  version       String   @default("1.0.0")
  trustBaseline Float    @default(0.85)
  sclCritical   Boolean  @default(false)
  pricingId     String?  @unique
  pricing       Pricing? @relation("AgentPricing", fields: [pricingId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ================================
// 🤖 Fase 3.5 — Governança Cognitiva Persistente
// Persistência de confiança por agente
// ================================

model AgentTrustScore {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  workspaceId  String?  @map("workspace_id")
  agentId      String   @map("agent_id")
  currentScore Int      @default(100) // Score ativo (0–200)
  baseline     Int      @default(100) // Valor inicial ou de referência
  lastDelta    Int      @default(0) // Última variação aplicada
  trend        String   @default("stable") // stable | rising | falling
  lastUpdated  DateTime @updatedAt @map("last_updated")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@unique([tenantId, workspaceId, agentId], name: "unique_trustscore_agent")
  @@index([tenantId, agentId, lastUpdated])
  @@map("agent_trust_scores")
}

model WhatsAppOptIn {
  id          String    @id
  tenantId    String    @map("tenant_id")
  workspaceId String    @map("workspace_id")
  phoneE164   String    @map("phone_e164")
  optedIn     Boolean   @default(true) @map("opted_in")
  source      String?
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")

  @@index([tenantId, workspaceId, phoneE164, createdAt(sort: Desc)])
  @@map("whatsapp_opt_in")
}

model WhatsAppMessageLog {
  id               String   @id
  tenantId         String   @map("tenant_id")
  workspaceId      String   @map("workspace_id")
  messageId        String   @unique @map("message_id")
  phoneE164        String   @map("phone_e164")
  payloadJson      Json     @map("payload_json")
  contextJson      Json?    @map("context_json")
  status           String   @default("sent")
  providerPayload  Json?    @map("provider_payload_json")
  sentAt           DateTime @default(now()) @map("sent_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([tenantId, workspaceId, phoneE164, sentAt(sort: Desc)])
  @@map("whatsapp_message_log")
}
