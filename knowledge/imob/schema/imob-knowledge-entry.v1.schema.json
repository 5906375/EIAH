{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "imob-knowledge-entry.v1",
  "title": "IMOB Knowledge Entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "category",
    "version",
    "summary",
    "content",
    "source",
    "lastUpdated",
    "riskLevel",
    "requiresHumanReview",
    "allowedScopes",
    "disallowedUses",
    "tags",
    "owners",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "category": {
      "type": "string",
      "enum": ["playbooks", "policies", "templates", "glossary", "checklists"]
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body"],
      "properties": {
        "body": {
          "type": "string",
          "minLength": 20
        },
        "checklist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "authority"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["internal_doc", "drive", "upload", "web", "canonical_policy"]
        },
        "ref": {
          "type": "string",
          "minLength": 3
        },
        "authority": {
          "type": "string",
          "enum": ["primary", "secondary", "advisory"]
        }
      }
    },
    "lastUpdated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "requiresHumanReview": {
      "type": "boolean"
    },
    "allowedScopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["tenant", "workspace", "role_scoped"]
      }
    },
    "disallowedUses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed"]
    }
  }
}

