{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "imob-knowledge-manifest.v1",
  "title": "IMOB Knowledge Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kbId",
    "schemaVersion",
    "version",
    "title",
    "description",
    "lastUpdated",
    "entrySchemaRef",
    "categories",
    "entries"
  ],
  "properties": {
    "kbId": {
      "type": "string",
      "const": "imob-knowledge-base"
    },
    "schemaVersion": {
      "type": "string",
      "const": "imob-kb-manifest.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "lastUpdated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "entrySchemaRef": {
      "type": "string",
      "minLength": 3
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["playbooks", "policies", "templates", "glossary", "checklists"]
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "category", "version"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3
          },
          "path": {
            "type": "string",
            "minLength": 3
          },
          "category": {
            "type": "string",
            "enum": ["playbooks", "policies", "templates", "glossary", "checklists"]
          },
          "version": {
            "type": "string",
            "pattern": "^v[0-9]+$"
          }
        }
      }
    }
  }
}

