# ============================================
# 🧠 EIAH_BUILDER — .gitignore padrão corporativo
# Fase 0–3: Infraestrutura, Governança e Observabilidade
# ============================================

# --------------------------------------------
# Pacotes, builds e caches
# --------------------------------------------
node_modules/
dist/
build/
apps/web/dist/
.pnpm-store/
.pnp.*
.cache/
coverage/
*.log
*.zip
*.odt

# --------------------------------------------
# Ambientes (.env) — política segura
# --------------------------------------------
# Nunca versionar env real
.env
**/.env
.env.*
**/.env.*

# Permitir apenas templates / exemplos / hashes
!.env.template
!.env.example
!.env.*.example
!.env.hash
!.env.governance.example

# --------------------------------------------
# Documentação e artefatos manuais
# --------------------------------------------
docs/*
!docs/.keep
!docs/EVIDENCE_INDEX.md
!docs/ops/
!docs/ops/**/
!docs/ops/**/*.md
!docs/ops/**/*.json
!docs/operations/
!docs/operations/**/
!docs/operations/**/*.md
docs/ops/**/*.mb
!docs/architecture/
docs/architecture/*
!docs/architecture/agent-chat-runtime.md
!docs/architecture/adr-imob-journey-governed-by-case.md
!docs/architecture/chat-runtime-entrypoint-debt.md
!docs/architecture/fase-3-dividas-documentadas-closure.md
!docs/architecture/imob-crm-governed-runtime.md
!docs/architecture/vertical-context-imob.md
!docs/architecture/p3-economy-hardening-closure.md
!docs/architecture/presentation-snapshot-v1.md
!docs/architecture/white-label-runtime-gap.md
!docs/architecture/EIAH_OUTPUTS_MATRIX_v1.md
!docs/architecture/worker-topology.md
!docs/architecture/existing-structure-preflight.md

# --------------------------------------------
# Dados temporários e uploads
# --------------------------------------------
uploads/
tmp/
*.sqlite

# --------------------------------------------
# IDE / Sistema
# --------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db


# --------------------------------------------
# Prisma legado e artefatos internos
# --------------------------------------------
apps/api/prisma_legacy/
apps/api/prisma_legacy/**


# Artefatos gerados indevidamente dentro de src
packages/**/src/**/*.d.ts
packages/**/src/**/*.js
packages/**/src/**/*.js.map
packages/**/src/**/*.d.ts.map
packages/**/src/**/*.tsbuildinfo

# Artefatos gerados fora de src (policy/, raiz do pacote)
packages/**/*.tsbuildinfo
packages/**/policy/*.js
packages/**/policy/*.js.map


# Temporários do repo
.tmp/
tmp_*
artifacts/
# Backups (não versionar)
Backups/
