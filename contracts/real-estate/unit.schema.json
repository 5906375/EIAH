{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eiah/contracts/real-estate/unit.schema.json",
  "title": "RealEstateUnit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenantId",
    "workspaceId",
    "portfolioId",
    "label"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "portfolioId": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    }
  }
}
