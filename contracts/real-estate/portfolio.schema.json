{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eiah/contracts/real-estate/portfolio.schema.json",
  "title": "RealEstatePortfolio",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenantId",
    "workspaceId",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
