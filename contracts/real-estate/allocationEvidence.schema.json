{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eiah/contracts/real-estate/allocationEvidence.schema.json",
  "title": "AllocationEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenantId",
    "workspaceId",
    "leaseId",
    "period",
    "evidenceRefs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "leaseId": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
