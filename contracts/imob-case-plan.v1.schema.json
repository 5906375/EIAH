{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eiah.local/contracts/imob-case-plan.v1.schema.json",
  "title": "IMOB Case Plan v1",
  "type": "object",
  "required": ["version", "mission", "stage", "resolved", "blockers", "primaryAction", "secondaryActions", "suppressedActions"],
  "properties": {
    "version": { "const": "1.0" },
    "mission": { "type": "string" },
    "stage": { "type": "string" },
    "resolved": {
      "type": "object",
      "required": ["owner", "property", "ownerLinkedToProperty", "lead", "documents", "seasonalRules", "visit", "proposal", "contract", "commission"],
      "properties": {
        "owner": { "type": "boolean" },
        "property": { "type": "boolean" },
        "ownerLinkedToProperty": { "type": "boolean" },
        "lead": { "type": "boolean" },
        "documents": { "type": "boolean" },
        "seasonalRules": { "type": "boolean" },
        "visit": { "type": "boolean" },
        "proposal": { "type": "boolean" },
        "contract": { "type": "boolean" },
        "commission": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "blockers": { "type": "array" },
    "primaryAction": {
      "anyOf": [
        { "$ref": "#/$defs/action" },
        { "type": "null" }
      ]
    },
    "secondaryActions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" },
      "maxItems": 2
    },
    "suppressedActions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["id", "label", "operation", "nextMessage", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "nextMessage": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["primary", "secondary", "neutral"] },
        "reasonCode": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
