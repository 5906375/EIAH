# ========================================================================
# 🧠 EIAH_BUILDER — TEMPLATE DE AMBIENTE UNIFICADO
# Fase 0–3: Infraestrutura Comum, Fundação Operacional e Governança Cognitiva
# Este arquivo serve como modelo versionado (.env.template)
# Cada ambiente (dev/staging/prod) deve criar sua cópia .env.local (gitignored)
# ========================================================================

# ------------------------------------------------------------------------
# [F0] INFRA CORE — PostgreSQL, Redis, Multi-Tenant Awareness
# ------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:CHANGE_ME@eiah-postgres:5432/eiah_builder?schema=public
REDIS_URL=redis://eiah-redis:6379/0

# Tenant e Workspace padrão (multi-tenant awareness)
TENANT_ID=tenant-demo
WORKSPACE_ID=workspace-demo

# ------------------------------------------------------------------------
# [F1] GATEWAY / CORE — API e Workers
# ------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
CI=true
PRISMA_CLIENT_ENGINE_TYPE=binary
EIAH_ENVIRONMENT_ID=eiah-dev
SERVICE_ROLE=api
RUN_QUEUE_CONSUMER_MODE=api-embedded
RUN_ATIVO_CONSUMER_MODE=disabled

# ------------------------------------------------------------------------
# [F1] AUTH / RBAC BÁSICO
# ------------------------------------------------------------------------
ADMIN_API_TOKEN=local-admin
# Escopos disponíveis: admin, core, agent, viewer
DEFAULT_USER_SCOPE=core
# DEV ONLY — não copiar estas relaxações para staging/produção.
EIAH_ALLOW_UNVERIFIED_WALLET=true
EIAH_ALLOW_PASSWORD_BOOTSTRAP=true
EIAH_ALLOW_EMAIL_PASSWORD_RESET=true
EIAH_ALLOW_GUARDRAIL_WARN_ONLY=true

# ------------------------------------------------------------------------
# [F2] OPENAI — Modelos de Linguagem, Embeddings e Actions
# ------------------------------------------------------------------------
OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_MS=45000
LLM_RETRIES=5
LLM_RETRY_DELAY_MS=150
LLM_RETRY_MAX_DELAY_MS=10000
LLM_RETRY_BACKOFF_FACTOR=1.6
LLM_RETRY_JITTER_RATIO=0.3

# ------------------------------------------------------------------------
# [F2] INTENT VALIDATOR CONFIG
# (Controla o comportamento do validador de intenção da IA)
# ------------------------------------------------------------------------
INTENT_VALIDATOR_MODE=enforce   # [observe|enforce]
INTENT_VALIDATOR_THRESHOLD=0.75 # mínimo de confiança
INTENT_VALIDATOR_LOG_LEVEL=info
INTENT_VALIDATOR_AUDIT_ENABLED=true

# ------------------------------------------------------------------------
# [F3] TRUST SCORE ENGINE (Governança Cognitiva)
# ------------------------------------------------------------------------
TRUST_SCORE_INITIAL=0.8
TRUST_SCORE_DECAY_RATE=0.01
TRUST_SCORE_REWARD_RATE=0.02
TRUST_SCORE_MIN_THRESHOLD=0.3
TRUST_SCORE_LOG_LEVEL=debug

# ------------------------------------------------------------------------
# [F1–F3] STORAGE E UPLOADS
# ------------------------------------------------------------------------
UPLOADS_DIR=./uploads
STORAGE_PROVIDER=local
# Quando STORAGE_PROVIDER=object, bucket/prefix devem apontar para o provider real.
# Credenciais e endpoint do provedor ficam fora do repositório (.env.local/secret manager).
OBJECT_STORAGE_ADAPTER=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PREFIX=uploads
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
DRAFT_STORE=redis
DRAFT_STORE_REDIS_URL=
DRAFT_TTL_MS=1800000
UPLOAD_RETENTION_DAYS=30
UPLOAD_CLEANUP_ENABLED=false
UPLOAD_CLEANUP_DRY_RUN=true
UPLOAD_CLEANUP_INTERVAL_MS=21600000
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=5
ALLOWED_UPLOAD_MIMES=application/pdf,image/png,image/jpeg,text/plain

# ------------------------------------------------------------------------
# [F1] FRONTEND / WEB CONFIG
# ------------------------------------------------------------------------
VITE_PROJECT_ID=demo-project
VITE_API_URL=http://127.0.0.1:8080/api
FRONTEND_URL=http://localhost:5173
VITE_API_TOKEN=REPLACE_ME
VITE_TENANT_ID=tenant-demo
VITE_WORKSPACE_ID=workspace-demo
VITE_LOG_LEVEL=info
VITE_ENABLE_SSE=true

# ------------------------------------------------------------------------
# [F3] OBSERVABILIDADE E LOGGING
# ------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_FORMAT=json
GUARDRAIL_LEDGER_ENABLED=true
GUARDRAIL_LEDGER_PATH=./logs/guardrail-ledger.log
ENABLE_TELEMETRY=true
ENABLE_SSE_REPLAY=true
ENABLE_RETRY_BACKOFF=true



# ------------------------------------------------------------------------
# [F0→F4] DLT COMPLIANCE GATE — CUSTÓDIA/ASSINATURA (off-chain)
# ------------------------------------------------------------------------
# Assinatura de execuções críticas antes de persistir no SCL.
# SIGNER_REQUIRED exige um signer externo (Vault/KMS/HSM).
# SIGNATURE_ENFORCE bloqueia execuções quando a assinatura não puder ser gerada.
SIGNATURE_DISABLED=false
SIGNATURE_TRUST_THRESHOLD=40
SIGNATURE_REQUIRED_RISK_LEVELS=high,critical
SIGNATURE_REQUIRE_ALWAYS=false
SIGNATURE_ENFORCE=true

# Signer provider:
# - local: dev only (chave em memória, exportável)
# - http: signer externo (Vault Transit / KMS proxy / HSM gateway)
SIGNER_REQUIRED=true
SIGNER_PROVIDER=vault
SIGNER_VAULT_URL=
SIGNER_VAULT_TOKEN=
SIGNER_HTTP_URL=
SIGNER_HTTP_TIMEOUT_MS=2000
# JSON de headers (pode conter segredo; mantenha fora de logs)
SIGNER_HTTP_HEADERS_JSON={}
# ------------------------------------------------------------------------
# [F4] SMART CONTRACT LEDGER (placeholder futuro)
# ------------------------------------------------------------------------
SCL_MODE=offchain
SCL_ENDPOINT=http://localhost:8545
SCL_TX_AUDIT_ENABLED=false

# ------------------------------------------------------------------------
# [F5] MARKETPLACE / POLÍTICAS AVANÇADAS (placeholder)
# ------------------------------------------------------------------------
MARKETPLACE_ENABLED=false
AUTO_POLICY_ENFORCEMENT=false
