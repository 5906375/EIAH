{
  "name": "@eiah/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "eiah": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --exclude '/app/node_modules/**' --exclude '/pnpm/store/**' src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "bash ../../scripts/prebuild-check.sh"
  },
  "dependencies": {
    "@eiah/core": "workspace:*",
    "@repo/db": "workspace:*",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
