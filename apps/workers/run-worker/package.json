    "ioredis": "^5.8.2",
    "pino": "^9.14.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
