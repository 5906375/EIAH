{
  "name": "@eiah/workers/maintenance-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude '/app/node_modules/**' --exclude '/pnpm/store/**' src/index.ts",
    "start": "node dist/index.js",
    "build": "pnpm run typecheck && tsup --config tsup.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "bash ../../../scripts/prebuild-check.sh"
  },
  "dependencies": {
    "@eiah/core": "workspace:*",
    "@repo/db": "workspace:*",
    "bullmq": "^5.62.0",
    "dotenv": "^16.6.1",
    "ioredis": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
