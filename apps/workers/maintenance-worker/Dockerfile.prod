# syntax=docker/dockerfile:1.7
FROM node:20-bookworm AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

RUN apt-get update && apt-get install -y \
  git python3 make g++ libc6 libstdc++6 libatomic1 libssl-dev \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/workers/maintenance-worker ./apps/workers/maintenance-worker

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile

# Prisma: fonte de verdade em packages/db
RUN pnpm --filter @repo/db prisma generate --schema packages/db/prisma/schema.prisma

# Build do worker
RUN pnpm --filter ./apps/workers/maintenance-worker... run build

# -------------------------

FROM node:20-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages

COPY --from=builder /app/apps/workers/maintenance-worker/package.json ./apps/workers/maintenance-worker/package.json
COPY --from=builder /app/apps/workers/maintenance-worker/dist ./apps/workers/maintenance-worker/dist

CMD ["node", "apps/workers/maintenance-worker/dist/index.js"]
