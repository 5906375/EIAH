{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",

  "name": "eiah-site",
  "compatibility_date": "2026-09-02",

  // O Worker só roda quando nenhum arquivo de public/ corresponde ao endereço.
  // Hoje ele atende apenas /api/votacao/ (votação ao vivo de /ia-na-pratica-juridica/).
  "main": "./src/worker.js",

  // Antes de cada deploy, confere o teto de 10 vitrines do piloto IMOB (apps/site/public/imob/<nome>/).
  // O Wrangler executa o comando na pasta de onde foi chamado (raiz do repositório ou apps/site),
  // por isso o caminho do script é escolhido pela pasta atual. O --check é sempre explícito.
  "build": {
    "command": "node -e \"const dir = require('node:fs').existsSync('scripts/publish-imob-pilot.mjs') ? './scripts/' : './apps/site/scripts/'; import(dir + 'publish-imob-pilot.mjs').then(pilot => pilot.main(['--check']))\""
  },

  "workers_dev": true,
  "preview_urls": true,

  "routes": [
    {
      "pattern": "eiah.ia.br",
      "custom_domain": true
    },
    {
      "pattern": "www.eiah.ia.br",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": false
  },

  // Salas da votação ao vivo: uma instância por sala, armazenamento SQLite, dados apagados em 24 h.
  "durable_objects": {
    "bindings": [
      {
        "name": "SALAS",
        "class_name": "SalaVotacao"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SalaVotacao"]
    }
  ]
}
