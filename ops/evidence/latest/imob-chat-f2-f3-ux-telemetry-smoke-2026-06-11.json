    "phase": "warn-only (warnOnly: true until 2 clean APE cycles)"
  },
  "validation": {
    "web_build": "pass",
    "ape_gate": "plugged in ape_cycle_weekly.cjs",
    "command": "pnpm check:imob-chat-telemetry"
