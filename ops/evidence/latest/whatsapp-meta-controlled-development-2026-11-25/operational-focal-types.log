const p = ts.parseJsonConfigFileContent(c.config, ts.sys, path.resolve('apps/api'));
const options = {...p.options, noEmit:true};
if (!options.strict) throw new Error('strictness must be preserved');
const roots = names.map(n=>path.resolve(n));
const program = ts.createProgram(roots, options);
const coverage = roots.map((n,i)=>({file:names[i],included:!!program.getSourceFile(n)}));
const diagnostics = [c.error,...p.errors,...ts.getPreEmitDiagnostics(program)].filter(Boolean);
const host = {getCanonicalFileName:n=>n,getCurrentDirectory:()=>process.cwd(),getNewLine:()=> '\n'};
console.log(JSON.stringify({typescript:ts.version,noEmit:options.noEmit,strict:options.strict,config:'apps/api/tsconfig.build.json',coverage,diagnostics:diagnostics.length}));
console.log(ts.formatDiagnostics(diagnostics,host)||'(no diagnostics)');
process.exitCode=diagnostics.length||coverage.some(c=>!c.included)?1:0;

